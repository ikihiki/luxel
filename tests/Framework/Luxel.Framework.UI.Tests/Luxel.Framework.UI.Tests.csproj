<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LuxelProjectRole>Test</LuxelProjectRole>
    <LuxelGalleryCategory>Framework</LuxelGalleryCategory>
    <LuxelSubsystem>Framework.UI</LuxelSubsystem>
    <LuxelPlatform>Portable</LuxelPlatform>
    <LuxelArchitectureTier>Extension</LuxelArchitectureTier>
  </PropertyGroup>
  <PropertyGroup>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Platform\Luxel.Platform\Luxel.Platform.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\..\src\Framework\Luxel.Framework.UI\Luxel.Framework.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Luxel.Platform" />
  </ItemGroup>
</Project>
