<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <LuxelProjectRole>GalleryHost</LuxelProjectRole>
    <LuxelGalleryCategory>Shared</LuxelGalleryCategory>
    <LuxelSubsystem>Gallery</LuxelSubsystem>
    <LuxelPlatform>Browser</LuxelPlatform>
    <LuxelArchitectureTier>Host</LuxelArchitectureTier>
    <IsPackable>false</IsPackable>
    <LuxelGalleryRegistrationIdentity>Host.Browser</LuxelGalleryRegistrationIdentity>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <LuxelBrowserWasm>true</LuxelBrowserWasm>
    <WasmBuildNative>true</WasmBuildNative>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Resources\Luxel.Resources.Gallery\Luxel.Resources.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Audio\Luxel.Audio.Gallery\Luxel.Audio.Gallery.csproj" />
    <ProjectReference Include="..\..\src\UI\Luxel.UI.Gallery\Luxel.UI.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Graphics\Luxel.Graphics.Gallery\Luxel.Graphics.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Input\Luxel.Input.Gallery\Luxel.Input.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Framework\Luxel.Framework.Gallery\Luxel.Framework.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Animation\Luxel.Animation.Gallery\Luxel.Animation.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Particles\Luxel.Particles.Gallery\Luxel.Particles.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Scripting\Luxel.Scripting.Gallery\Luxel.Scripting.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Editor\Luxel.Editor.Gallery\Luxel.Editor.Gallery.csproj" />
    <ProjectReference Include="..\..\src\DevTools\Luxel.DevTools.Gallery\Luxel.DevTools.Gallery.csproj" />
    <ProjectReference Include="..\..\src\GamesSamples\Luxel.GamesSamples.Gallery\Luxel.GamesSamples.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Gallery\Luxel.Gallery.Docs\Luxel.Gallery.Docs.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="BepuUtilities" Version="2.4.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.0" ExcludeAssets="all" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gallery\Luxel.Gallery.Browser\Luxel.Gallery.Browser.csproj" />
    <ProjectReference Include="..\..\src\Resources\Luxel.Resources.Gallery\Luxel.Resources.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Audio\Luxel.Audio.Gallery\Luxel.Audio.Gallery.csproj" />
  </ItemGroup>
  <ItemGroup>
    <_GalleryBrowserLinkedAsset Include="..\..\src\Graphics\Luxel.Shaders.Slang.Browser\wwwroot\slang-browser.js">
      <TargetPath>slang-browser.js</TargetPath>
    </_GalleryBrowserLinkedAsset>
    <_GalleryBrowserLinkedAsset Include="..\..\src\Graphics\Luxel.Shaders.Slang.Browser\wwwroot\slang-browser-runtime.js">
      <TargetPath>slang-browser-runtime.js</TargetPath>
    </_GalleryBrowserLinkedAsset>
    <_GalleryBrowserLinkedAsset Include="..\..\src\Graphics\Luxel.Shaders.Slang.Browser\wwwroot\slang-worker.js">
      <TargetPath>slang-worker.js</TargetPath>
    </_GalleryBrowserLinkedAsset>
    <_GalleryBrowserLinkedAsset Include="..\..\src\Graphics\Luxel.Shaders.Slang.Browser\wwwroot\slang\**\*">
      <TargetPath>slang\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </_GalleryBrowserLinkedAsset>
    <_GalleryBrowserLinkedAsset Include="..\..\src\Audio\Luxel.Audio.Browser\wwwroot\luxel-audio-browser.js">
      <TargetPath>luxel-audio-browser.js</TargetPath>
    </_GalleryBrowserLinkedAsset>
    <_GalleryBrowserLinkedAsset Include="..\..\src\Graphics\Luxel.Graphics.WebGPU.Browser\wwwroot\luxel-webgpu-browser.js">
      <TargetPath>luxel-webgpu-browser.js</TargetPath>
    </_GalleryBrowserLinkedAsset>
    <_GalleryBrowserLinkedAsset Include="..\..\src\Platform\Luxel.Platform.Web\wwwroot\luxel-platform-web.js">
      <TargetPath>luxel-platform-web.js</TargetPath>
    </_GalleryBrowserLinkedAsset>
  </ItemGroup>
  <Target Name="CollectGalleryRoslynMetadataReferences" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_GalleryRoslynMetadataReference Include="@(ReferencePath)"
        Condition="'%(Filename)' == 'mscorlib' Or '%(Filename)' == 'netstandard' Or '%(Filename)' == 'System.Runtime' Or '%(Filename)' == 'System.Console' Or '%(Filename)' == 'System.Collections' Or '%(Filename)' == 'System.Linq' Or '%(Filename)' == 'System.Memory' Or '%(Filename)' == 'System.Numerics.Vectors' Or '%(Filename)' == 'Luxel.Scripting.Roslyn.Web' Or '%(Filename)' == 'Luxel.Scripting' Or '%(Filename)' == 'Luxel.UI' Or '%(Filename)' == 'Luxel.Controls' Or '%(Filename)' == 'Luxel.Graphics' Or '%(Filename)' == 'Luxel.Graphics.TwoD'" />
    </ItemGroup>
  </Target>
  <Target Name="PrepareGalleryBrowserStaticWebAssets"
          BeforeTargets="GenerateComputedBuildStaticWebAssets"
          DependsOnTargets="CollectGalleryRoslynMetadataReferences">
    <PropertyGroup>
      <_GalleryBrowserStaticRoot>$(IntermediateOutputPath)gallery-browser-static\</_GalleryBrowserStaticRoot>
      <_GalleryBrowserManifestPath>$(_GalleryBrowserStaticRoot)references\manifest.json</_GalleryBrowserManifestPath>
      <_GalleryBrowserManifestAssemblies>@(_GalleryRoslynMetadataReference->'    &quot;%(Filename)%(Extension)&quot;', ',&#x0D;&#x0A;')</_GalleryBrowserManifestAssemblies>
      <_GalleryBrowserManifest>{
  &quot;version&quot;: 1,
  &quot;assemblies&quot;: [
$(_GalleryBrowserManifestAssemblies)
  ]
}</_GalleryBrowserManifest>
    </PropertyGroup>
    <ItemGroup>
      <_GalleryBrowserStagedAsset Include="@(_GalleryBrowserLinkedAsset)">
        <Destination>$(_GalleryBrowserStaticRoot)%(_GalleryBrowserLinkedAsset.TargetPath)</Destination>
      </_GalleryBrowserStagedAsset>
      <_GalleryBrowserStagedReference Include="@(_GalleryRoslynMetadataReference)">
        <Destination>$(_GalleryBrowserStaticRoot)references\%(_GalleryRoslynMetadataReference.Filename)%(_GalleryRoslynMetadataReference.Extension)</Destination>
      </_GalleryBrowserStagedReference>
      <_GalleryBrowserStageDirectory Include="@(_GalleryBrowserStagedAsset->'$([System.IO.Path]::GetDirectoryName(%(Destination)))')" />
      <_GalleryBrowserStageDirectory Include="@(_GalleryBrowserStagedReference->'$([System.IO.Path]::GetDirectoryName(%(Destination)))')" />
      <_GalleryBrowserStageDirectory Include="$([System.IO.Path]::GetDirectoryName('$(_GalleryBrowserManifestPath)'))" />
    </ItemGroup>
    <MakeDir Directories="@(_GalleryBrowserStageDirectory)" />
    <Copy SourceFiles="@(_GalleryBrowserStagedAsset)"
          DestinationFiles="@(_GalleryBrowserStagedAsset->'%(Destination)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_GalleryBrowserStagedReference)"
          DestinationFiles="@(_GalleryBrowserStagedReference->'%(Destination)')"
          SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(_GalleryBrowserManifestPath)"
                      Lines="$(_GalleryBrowserManifest)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="ASCII" />
    <ItemGroup>
      <_GalleryBrowserStaticAsset Include="@(_GalleryBrowserStagedAsset->'%(Destination)');@(_GalleryBrowserStagedReference->'%(Destination)');$(_GalleryBrowserManifestPath)"
                                  CopyToOutputDirectory="PreserveNewest"
                                  CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="@(_GalleryBrowserStaticAsset)" />
    </ItemGroup>
    <DefineStaticWebAssets CandidateAssets="@(_GalleryBrowserStaticAsset)"
                           FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
                           FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
                           RelativePathPattern="**"
                           SourceType="Computed"
                           SourceId="$(PackageId)"
                           ContentRoot="$(_GalleryBrowserStaticRoot)"
                           BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_GalleryBrowserComputedStaticWebAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints CandidateAssets="@(_GalleryBrowserComputedStaticWebAsset)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>
  <ItemGroup>
    <TrimmerRootAssembly Include="Luxel.Physics" />
    <TrimmerRootAssembly Include="Luxel.Physics.Gizmos" />
    <TrimmerRootAssembly Include="BepuPhysics" />
    <TrimmerRootAssembly Include="BepuUtilities" />
    <TrimmerRootAssembly Include="Luxel.AssetRuntime" />
  </ItemGroup>
  <Import Project="..\..\assets\Luxel.KhronosBox.targets" />
  <ItemGroup>
    <Content Include="$(KhronosBoxGltfPath)" Link="wwwroot\tools\khronos-samples\Box\Box.gltf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(KhronosBoxBinPath)" Link="wwwroot\tools\khronos-samples\Box\Box0.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(KhronosBoxLicensePath)" Link="wwwroot\tools\khronos-samples\Box\LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(KhronosBoxAnimatedPath)" Link="wwwroot\tools\khronos-samples\BoxAnimated\BoxAnimated.glb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(KhronosBoxAnimatedLicensePath)" Link="wwwroot\tools\khronos-samples\BoxAnimated\LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(KhronosRiggedSimplePath)" Link="wwwroot\tools\khronos-samples\RiggedSimple\RiggedSimple.glb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(KhronosRiggedSimpleLicensePath)" Link="wwwroot\tools\khronos-samples\RiggedSimple\LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
