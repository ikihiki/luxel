@using Luxel.Gallery.Presentation

<ul class="story-tree">
    @foreach (GalleryNavigationNode node in Nodes)
    {
        <li data-navigation-kind="@node.Kind.ToString().ToLowerInvariant()" data-canonical-path="@node.CanonicalPath">
            @if (node.Children.Count > 0)
            {
                <details open="@(SearchActive || Contains(node, ActivePath))">
                    <summary>
                        <span>@node.DisplayLabel</span>
                        @if (node.TargetPath is { } targetPath)
                        {
                            <a class="folder-story-link @(targetPath == ActivePath ? "active" : null)"
                               data-navigation-kind="@node.Kind.ToString().ToLowerInvariant()"
                               data-canonical-path="@node.CanonicalPath" data-target-path="@targetPath"
                               href="@StoryHref(targetPath)" aria-current="@(targetPath == ActivePath ? "page" : null)"
                               @onclick="() => SelectStory(targetPath)" @onclick:preventDefault @onclick:stopPropagation>
                                @(node.Kind == GalleryNavigationNodeKind.Component ? GalleryLabels.Documentation : node.DisplayLabel)
                            </a>
                        }
                    </summary>
                    <StoryTree Nodes="node.Children" ActivePath="@ActivePath" SearchActive="SearchActive"
                               StorySelected="StorySelected" />
                </details>
            }
            else if (node.TargetPath is { } targetPath)
            {
                <a class="story-link @(targetPath == ActivePath ? "active" : null)"
                   data-navigation-kind="@node.Kind.ToString().ToLowerInvariant()"
                   data-canonical-path="@node.CanonicalPath" data-target-path="@targetPath"
                   href="@StoryHref(targetPath)" title="@targetPath"
                   aria-current="@(targetPath == ActivePath ? "page" : null)"
                   @onclick="() => SelectStory(targetPath)" @onclick:preventDefault>
                    <span>@node.DisplayLabel</span>
                </a>
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<GalleryNavigationNode> Nodes { get; set; } = [];
    [Parameter, EditorRequired] public string ActivePath { get; set; } = "";
    [Parameter] public bool SearchActive { get; set; }
    [Parameter] public EventCallback<string> StorySelected { get; set; }

    private Task SelectStory(string path) => StorySelected.InvokeAsync(path);
    private static string StoryHref(string path) => "?story=" + Uri.EscapeDataString(path);
    private static bool Contains(GalleryNavigationNode node, string path)
        => node.TargetPath == path || node.Children.Any(child => Contains(child, path));
}
