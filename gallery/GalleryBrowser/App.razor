@using System.Runtime.InteropServices.JavaScript
@using Luxel.Gallery
@using Luxel.Gallery.Browser
@inject StoryCatalog Catalog
@inject IServiceProvider Services
@inject NavigationManager Navigation

<canvas id="luxel-canvas" tabindex="0" aria-label="Luxel browser WebGPU"></canvas>
<div id="status" hidden data-status="loading"></div>
<div id="error" role="alert" hidden></div>

@code {
    private bool _started;
    private JSObject? _browserHostModule;
    private JSObject? _slangModule;
    private JSObject? _webGpuModule;
    private JSObject? _audioModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;

        Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        Dictionary<string, string> query = ParseQuery(uri.Query);
        string? requested = query.GetValueOrDefault("story");
        StoryInfo story = requested is null ? Catalog.All[0] : Catalog.Find(requested)
            ?? throw new InvalidOperationException($"Unknown browser story '{requested}'.");
        string argsJson = query.GetValueOrDefault("args") ?? "{}";

        _browserHostModule = await JSHost.ImportAsync("luxel-browser-host", "../main.js");
        _slangModule = await JSHost.ImportAsync("luxel-slang", "../slang-browser.js");
        _webGpuModule = await JSHost.ImportAsync("./luxel-webgpu-browser.js", "../luxel-webgpu-browser.js");
        _audioModule = await JSHost.ImportAsync("./luxel-audio-browser.js", "../luxel-audio-browser.js");
        _ = RunStoryAsync(story.Path, argsJson);
    }

    private async Task RunStoryAsync(string story, string argsJson)
    {
        try
        {
            await BrowserGalleryApplication.RunAsync(Services, story, argsJson);
        }
        catch
        {
            // BrowserGalleryApplication publishes the full failure to the runtime status surface.
        }
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var values = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (string item in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            string[] pair = item.Split('=', 2);
            values[Uri.UnescapeDataString(pair[0])] = pair.Length == 2 ? Uri.UnescapeDataString(pair[1]) : "";
        }
        return values;
    }
}
