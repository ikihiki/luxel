@using System.Globalization
@using System.Runtime.InteropServices.JavaScript
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Luxel.Gallery
@using Luxel.Gallery.Browser
@using Luxel.Gallery.Presentation
@using Luxel.UI
@implements IDisposable
@implements IAsyncDisposable
@inject StoryCatalog Catalog
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IJSRuntime JS

<style id="gallery-shared-tokens">@((MarkupString)GalleryChromeCss.RenderStyleSheet())</style>

@if (_embedded)
{
    <main class="gallery-embed">
        <canvas id="luxel-canvas" tabindex="0" aria-label="Luxel browser WebGPU"></canvas>
        <div id="status" hidden data-status="loading"></div>
        <div id="error" role="alert" hidden></div>
    </main>
}
else
{
    <div class="@ShellClass()" data-navigation-open="@(_navigationOpen ? "true" : "false")"
         @onkeydown="OnShellKeyDown">
        @if (!_compact)
        {
        <button class="navigation-backdrop" type="button" tabindex="-1" aria-label="@GalleryLabels.CloseNavigation"
                @onclick="CloseNavigationAsync"></button>
        <aside id="gallery-navigation" class="gallery-sidebar" aria-label="@GalleryLabels.StoryNavigation">
            <header class="gallery-brand">
                <span class="gallery-mark" aria-hidden="true">L</span>
                <span><strong>Luxel</strong><small>コントロールギャラリー</small></span>
                <button class="sidebar-close" type="button" title="@GalleryLabels.CloseNavigation"
                        aria-label="@GalleryLabels.CloseNavigation" @onclick="CloseNavigationAsync">×</button>
            </header>
            <label class="gallery-search">
                <span aria-hidden="true">⌕</span>
                <input id="gallery-story-search" type="search" placeholder="@GalleryLabels.SearchStories" aria-label="@GalleryLabels.SearchStories"
                       @bind="_search" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <button type="button" title="@GalleryLabels.ClearSearch" aria-label="@GalleryLabels.ClearSearch" @onclick="ClearSearch">×</button>
                }
            </label>
            <nav class="story-navigation" aria-label="@GalleryLabels.StoryNavigation">
                @{ IReadOnlyList<GalleryNavigationNode> tree = FilteredTree(); }
                @if (tree.Count > 0)
                {
                    <StoryTree Nodes="tree" ActivePath="@_story.Path" SearchActive="@(!string.IsNullOrWhiteSpace(_search))"
                               StorySelected="SelectStory" />
                }
                else
                {
                    <p class="empty-search">@GalleryLabels.NoStories</p>
                }
            </nav>
            <footer class="gallery-sidebar-footer">@StoryCountLabel()</footer>
        </aside>
        }

        <main class="@(_documentHtml is not null ? "gallery-main gallery-main-document" : "gallery-main")">
            @if (!_compact)
            {
            <header class="story-toolbar">
                <button id="gallery-navigation-toggle" class="mobile-navigation-toggle" type="button"
                        aria-label="@(_navigationOpen ? GalleryLabels.CloseNavigation : GalleryLabels.OpenNavigation)" aria-controls="gallery-navigation"
                        aria-expanded="@(_navigationOpen ? "true" : "false")" @onclick="ToggleNavigationAsync">
                    <span aria-hidden="true">☰</span>
                </button>
                <div class="story-toolbar-heading">
                    <p class="story-component">@_story.Component</p>
                    <h1>@StoryDisplayLabel()</h1>
                    @if (!string.IsNullOrWhiteSpace(_story.ShortDescription))
                    {
                        <p class="story-short-description">@_story.ShortDescription</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_story.LongDescription))
                    {
                        <p class="story-long-description">@_story.LongDescription</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_story.CapabilityNote))
                    {
                        <aside class="story-capability-warning" role="note">
                            <strong>@GalleryLabels.CapabilityWarning</strong><span>@_story.CapabilityNote</span>
                        </aside>
                    }
                </div>
                <div class="story-toolbar-actions">
                    <div class="story-theme-controls">
                        <GalleryThemePicker Value="@_shellTheme" Label="@GalleryLabels.ShellTheme"
                                            AriaLabel="@GalleryLabels.ShellTheme" ValueChanged="SetShellThemeAsync" />
                        <GalleryThemePicker Value="@_previewTheme" Label="@GalleryLabels.PreviewTheme"
                                            AriaLabel="@GalleryLabels.PreviewTheme" IncludeSystem="false"
                                            ValueChanged="SetPreviewThemeAsync" />
                        <button class="theme-synchronization" type="button"
                                aria-pressed="@(_synchronizePreviewTheme ? "true" : "false")"
                                title="@GalleryLabels.SynchronizePreviewTheme" @onclick="TogglePreviewThemeSynchronizationAsync">
                            <span aria-hidden="true">↔</span><span>@GalleryLabels.SynchronizePreviewTheme</span>
                        </button>
                    </div>
                    <a class="open-alone" href="@EmbeddedStoryHref(_story.Path, _argsJson)" target="_blank" rel="noopener"
                       title="プレビューを新しいタブで開く">プレビューを開く <span aria-hidden="true">↗</span></a>
                </div>
            </header>
            }
            @if (_documentHtml is not null)
            {
                <article class="markdown-document">
                    @((MarkupString)_documentHtml)
                    @if (!_pageNavigation.IsEmpty)
                    {
                        <nav class="markdown-page-navigation" aria-label="ページナビゲーション">
                            @if (_pageNavigation.Previous is { } previous)
                            {
                                <a class="previous" href="@StoryHref(previous.Path)">
                                    <small>前へ</small><strong>← @previous.Name</strong>
                                </a>
                            }
                            @if (_pageNavigation.Next is { } next)
                            {
                                <a class="next" href="@StoryHref(next.Path)">
                                    <small>次へ</small><strong>@next.Name →</strong>
                                </a>
                            }
                        </nav>
                    }
                </article>
            }
            else
            {
                <div class="story-workspace" @ref="_workspace">
                    <section class="story-preview" aria-label="@GalleryLabels.Preview" data-label="@GalleryLabels.Preview">
                        @if (_compact)
                        {
                            <canvas id="luxel-canvas" tabindex="0" aria-label="Luxel browser WebGPU"></canvas>
                            <div id="status" hidden data-status="loading"></div>
                            <div id="error" role="alert" hidden></div>
                        }
                        else
                        {
                            <iframe @key="_runtimeUrl" @ref="_runtimeFrame" class="story-runtime-frame" src="@_runtimeUrl"
                                    title="@_story.Path" allow="autoplay; clipboard-read; clipboard-write"></iframe>
                        }
                    </section>
                    <div class="story-splitter" @ref="_splitter" role="separator" tabindex="0"
                         aria-label="ストーリープレビューと詳細の大きさを変更" aria-orientation="horizontal"
                         aria-valuemin="150" aria-valuemax="800" aria-valuenow="260"></div>
                    <section class="story-lower-panel" aria-label="ストーリーの詳細">
                        <div class="story-tabs" role="tablist" aria-label="ストーリーの詳細">
                            @foreach (string tab in Tabs)
                            {
                                <button id="@TabId(tab)" type="button" role="tab"
                                        aria-selected="@(_activeTab == tab ? "true" : "false")" aria-controls="@PanelId(tab)"
                                        tabindex="@(_activeTab == tab ? 0 : -1)" class="@TabClass(tab)"
                                        @onclick="() => SelectTab(tab)" @onkeydown="eventArgs => OnTabKeyDown(eventArgs, tab)">@TabLabel(tab)</button>
                            }
                        </div>
                        <div id="@PanelId(_activeTab)" class="story-tab-panel" role="tabpanel"
                             aria-labelledby="@TabId(_activeTab)" tabindex="0">
                            @if (_activeTab == "Args")
                            {
                                @if (_argDefinitions.Count == 0)
                                {
                                    <p class="panel-empty">このストーリーには編集可能な引数がありません。</p>
                                }
                                else
                                {
                                    <div class="args-table">
                                        @foreach (StoryArgDefinition definition in _argDefinitions)
                                        {
                                            <div class="arg-row">
                                                <label for="@ArgId(definition)">
                                                    <strong>@definition.Name</strong>
                                                    <small>@definition.Type</small>
                                                    @if (!string.IsNullOrWhiteSpace(definition.Description))
                                                    {
                                                        <span>@definition.Description</span>
                                                    }
                                                </label>
                                                @if ((definition.EditorKind is StoryArgEditorKind.Enum or StoryArgEditorKind.Preset)
                                                    && definition.Options is { Count: > 0 })
                                                {
                                                    <select id="@ArgId(definition)" value="@ArgValue(definition)"
                                                            @onchange="eventArgs => UpdateArgAsync(definition, eventArgs.Value)">
                                                        @foreach (string option in definition.Options)
                                                        {
                                                            <option value="@option">@PresetLabel(option)</option>
                                                        }
                                                    </select>
                                                }
                                                else if (definition.EditorKind == StoryArgEditorKind.Boolean)
                                                {
                                                    <input id="@ArgId(definition)" type="checkbox" checked="@ArgBoolValue(definition)"
                                                           @onchange="eventArgs => UpdateArgAsync(definition, eventArgs.Value)" />
                                                }
                                                else if (definition.EditorKind == StoryArgEditorKind.Color)
                                                {
                                                    <div class="arg-color-editor">
                                                        <input id="@ArgId(definition)" type="color" value="@ArgColorSwatch(definition)"
                                                               aria-label="@($"{definition.Name} の色")"
                                                               @oninput="eventArgs => UpdateArgAsync(definition, eventArgs.Value)" />
                                                        <input class="arg-color-hex" value="@ArgValue(definition)" aria-label="@($"{definition.Name} の16進色")"
                                                               @onchange="eventArgs => UpdateArgAsync(definition, eventArgs.Value)" />
                                                    </div>
                                                }
                                                else if (definition.EditorKind == StoryArgEditorKind.Json)
                                                {
                                                    <RawJsonEditor @key="definition.Name" Id="@ArgId(definition)"
                                                                   Document="@_jsonArgDocuments[definition.Name]" />
                                                }
                                                else
                                                {
                                                    <input id="@ArgId(definition)" type="@(definition.EditorKind == StoryArgEditorKind.Number ? "number" : "text")"
                                                           value="@ArgValue(definition)" min="@definition.Min" max="@definition.Max" step="@ArgStep(definition)"
                                                           @onchange="eventArgs => UpdateArgAsync(definition, eventArgs.Value)" />
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else if (_activeTab == "Output")
                            {
                                <div class="output-status" data-runtime-state="@_runtimeState">
                                    <span class="runtime-dot" aria-hidden="true"></span>
                                    <strong>@RuntimeStateLabel()</strong>
                                    @if (!string.IsNullOrWhiteSpace(_runtimeSummary))
                                    {
                                        <span>@_runtimeSummary</span>
                                    }
                                </div>
                                @if (_output.Count == 0)
                                {
                                    <p class="panel-empty">ランタイムのイベントとエラーがここに表示されます。</p>
                                }
                                else
                                {
                                    <ol class="output-list" aria-live="polite">
                                        @foreach (OutputEntry entry in _output)
                                        {
                                            <li class="output-@entry.Kind"><time>@entry.Time</time><strong>@OutputKindLabel(entry.Kind)</strong><pre>@entry.Text</pre></li>
                                        }
                                    </ol>
                                }
                            }
                            else
                            {
                                <SourcePanel Source="@_story.Source" />
                            }
                        </div>
                    </section>
                </div>
            }
        </main>
    </div>
}

@code {
    private static readonly string[] Tabs = ["Args", "Output", "Source"];
    private bool _started;
    private bool _embedded;
    private bool _compact;
    private bool _navigationOpen;
    private bool _appearanceLoaded;
    private bool _synchronizePreviewTheme;
    private string _shellTheme = "system";
    private string _previewTheme = "light";
    private string _argsJson = "{}";
    private string _search = "";
    private string? _documentHtml;
    private StoryPageNavigation _pageNavigation;
    private string _runtimeUrl = "";
    private string _runtimeInstance = "";
    private string _activeTab = "Args";
    private string _runtimeState = "loading";
    private string _runtimeSummary = "ストーリーランタイムを待機しています。";
    private int _sentRevision;
    private int _revision;
    private StoryInfo _story = null!;
    private GalleryNavigationModel _navigation = null!;
    private IReadOnlyList<StoryInfo> _displayStories = Array.Empty<StoryInfo>();
    private IReadOnlyList<StoryArgDefinition> _argDefinitions = Array.Empty<StoryArgDefinition>();
    private Dictionary<string, JsonElement> _argValues = new(StringComparer.Ordinal);
    private Dictionary<string, StoryJsonArgDocument> _jsonArgDocuments = new(StringComparer.Ordinal);
    private readonly List<OutputEntry> _output = [];
    private ElementReference _workspace;
    private ElementReference _runtimeFrame;
    private ElementReference _splitter;
    private IJSObjectReference? _galleryHostModule;
    private IJSObjectReference? _runtimeModule;
    private DotNetObjectReference<App>? _galleryHostReceiver;
    private JSObject? _browserHostModule;
    private JSObject? _slangModule;
    private JSObject? _webGpuModule;
    private JSObject? _audioModule;

    protected override void OnInitialized()
    {
        _navigation = GalleryNavigationBuilder.Build(Catalog);
        _displayStories = _navigation.Stories.Select(story => story.Info).ToArray();
        LoadLocation(Navigation.Uri);
        if (!_embedded) Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_embedded || _compact)
        {
            if (!firstRender || _started) return;
            _started = true;
            if (_compact)
            {
                _galleryHostReceiver = DotNetObjectReference.Create(this);
                _runtimeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./main.js");
                await _runtimeModule.InvokeVoidAsync("setLocalReceiver", _galleryHostReceiver);
                _galleryHostModule = await JS.InvokeAsync<IJSObjectReference>("import", "./gallery-host.js");
                await _galleryHostModule.InvokeVoidAsync("wireSplitter", _workspace, _splitter);
            }
            _browserHostModule = await JSHost.ImportAsync("luxel-browser-host", "../main.js");
            _slangModule = await JSHost.ImportAsync("luxel-slang", "../slang-browser.js");
            _webGpuModule = await JSHost.ImportAsync("./luxel-webgpu-browser.js", "../luxel-webgpu-browser.js");
            _audioModule = await JSHost.ImportAsync("./luxel-audio-browser.js", "../luxel-audio-browser.js");
            _ = RunStoryAsync(_story.Path, _argsJson);
            return;
        }

        _galleryHostModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./gallery-host.js");
        if (!_appearanceLoaded)
        {
            _shellTheme = await _galleryHostModule.InvokeAsync<string>("getShellTheme");
            _previewTheme = await _galleryHostModule.InvokeAsync<string>("getPreviewTheme");
            _synchronizePreviewTheme = await _galleryHostModule.InvokeAsync<bool>("getPreviewThemeSynchronization");
            if (_synchronizePreviewTheme)
                _previewTheme = await _galleryHostModule.InvokeAsync<string>("getResolvedShellTheme");
            _appearanceLoaded = true;
            StateHasChanged();
        }
        if (_galleryHostReceiver is null)
        {
            _galleryHostReceiver = DotNetObjectReference.Create(this);
            await _galleryHostModule.InvokeVoidAsync("initialize", _galleryHostReceiver);
        }
        if (_documentHtml is null)
        {
            await _galleryHostModule.InvokeVoidAsync("configure", _runtimeFrame, _story.Path, _runtimeInstance);
            await _galleryHostModule.InvokeVoidAsync("applyPreviewTheme", _previewTheme);
            await SendArgsAsync();
            await _galleryHostModule.InvokeVoidAsync("wireSplitter", _workspace, _splitter);
        }
    }

    private void LoadLocation(string location)
    {
        Uri uri = Navigation.ToAbsoluteUri(location);
        Dictionary<string, string> query = ParseQuery(uri.Query);
        _embedded = query.GetValueOrDefault("embed") is "1" or "true";
        _compact = !_embedded && query.GetValueOrDefault("compact") is "1" or "true";
        string? requested = query.GetValueOrDefault("story");
        _story = requested is null ? _displayStories[0] : Catalog.Find(requested)
            ?? throw new InvalidOperationException($"Unknown browser story '{requested}'.");
        _argsJson = query.GetValueOrDefault("args") ?? "{}";
        _documentHtml = _embedded ? null : TryRenderDocument(_story, _argsJson);
        _pageNavigation = _documentHtml is null ? default : StoryPageNavigation.Resolve(Catalog, _story);
        _argDefinitions = (_story.ArgDefinitions ?? Array.Empty<StoryArgDefinition>())
            .OrderBy(definition => definition.Order).ThenBy(definition => definition.Name, StringComparer.Ordinal).ToArray();
        StoryArgs canonicalArgs = StoryArgs.Parse(_argsJson).WithDefaults(_argDefinitions);
        _argValues = canonicalArgs.Values.ToDictionary(pair => pair.Key, pair => pair.Value.Clone(), StringComparer.Ordinal);
        _jsonArgDocuments = _argDefinitions
            .Where(definition => definition.EditorKind == StoryArgEditorKind.Json)
            .ToDictionary(definition => definition.Name,
                definition => new StoryJsonArgDocument(definition, _argValues[definition.Name],
                    accepted => AcceptJsonArg(definition, accepted)), StringComparer.Ordinal);
        _argsJson = canonicalArgs.ToJson();
        _runtimeInstance = Guid.NewGuid().ToString("N");
        _revision = 0;
        _sentRevision = 0;
        _runtimeState = "loading";
        _runtimeSummary = "ストーリーランタイムを待機しています。";
        _output.Clear();
        _runtimeUrl = _embedded || _compact || _documentHtml is not null
            ? ""
            : EmbeddedStoryHref(_story.Path, _argsJson, _runtimeInstance);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            LoadLocation(args.Location);
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task OnRuntimeMessage(JsonElement message)
    {
        string type = message.GetProperty("type").GetString() ?? "event";
        bool acceptSnapshot = true;
        if (message.TryGetProperty("revision", out JsonElement revision) && revision.TryGetInt32(out int runtimeRevision))
        {
            acceptSnapshot = runtimeRevision >= _revision;
            _revision = Math.Max(_revision, runtimeRevision);
        }
        if (acceptSnapshot && message.TryGetProperty("args", out JsonElement args) && args.ValueKind == JsonValueKind.Object)
        {
            StoryArgs snapshot = new(args.EnumerateObject().Select(property => KeyValuePair.Create(property.Name, property.Value)));
            _argValues = snapshot.Values.ToDictionary(pair => pair.Key, pair => pair.Value.Clone(), StringComparer.Ordinal);
            foreach ((string name, StoryJsonArgDocument document) in _jsonArgDocuments)
            {
                if (_argValues.TryGetValue(name, out JsonElement acceptedValue))
                    document.RefreshAccepted(acceptedValue, _revision.ToString(CultureInfo.InvariantCulture));
            }
            _argsJson = snapshot.ToJson();
        }

        switch (type)
        {
            case "ready":
                _runtimeState = message.TryGetProperty("state", out JsonElement readyState) ? readyState.GetString() ?? "pass" : "pass";
                _runtimeSummary = message.TryGetProperty("summary", out JsonElement summary) ? summary.GetString() ?? "ランタイムの準備が完了しました。" : "ランタイムの準備が完了しました。";
                break;
            case "args-changed":
                _runtimeState = "pass";
                AddOutput("args", message.TryGetProperty("source", out JsonElement source)
                    ? $"引数を変更しました（{source.GetString()}）。" : "引数を変更しました。");
                break;
            case "arg-error":
                _runtimeState = "fail";
                AddOutput("error", MessageErrors(message));
                _activeTab = "Output";
                break;
            case "event":
                AddOutput("event", message.TryGetProperty("entry", out JsonElement entry) ? entry.GetRawText() : "イベント");
                break;
            case "story-error":
                _runtimeState = "fail";
                _runtimeSummary = message.TryGetProperty("error", out JsonElement error) ? error.GetString() ?? "ストーリーの実行に失敗しました。" : "ストーリーの実行に失敗しました。";
                AddOutput("error", _runtimeSummary);
                _activeTab = "Output";
                break;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void AcceptJsonArg(StoryArgDefinition definition, JsonElement acceptedValue)
    {
        _argValues[definition.Name] = acceptedValue.Clone();
        _argsJson = new StoryArgs(_argValues).ToJson();
        _revision = checked(_revision + 1);
        _ = InvokeAsync(SendArgsAsync);
    }

    private async Task UpdateArgAsync(StoryArgDefinition definition, object? rawValue)
    {
        try
        {
            _argValues[definition.Name] = ParseArgValue(definition, rawValue);
            _argsJson = new StoryArgs(_argValues).ToJson();
            _revision++;
            await SendArgsAsync();
        }
        catch (Exception error) when (error is FormatException or JsonException or OverflowException)
        {
            _runtimeState = "fail";
            AddOutput("error", $"{definition.Name}: {error.Message}");
            _activeTab = "Output";
        }
    }

    private async Task SendArgsAsync()
    {
        if (_revision <= _sentRevision) return;
        int revision = _revision;
        string requestId = $"args-{revision}-{Guid.NewGuid():N}";
        if (_compact && _runtimeModule is not null)
            await _runtimeModule.InvokeVoidAsync("setArgs", revision, requestId, _argsJson);
        else if (!_compact && _galleryHostModule is not null)
            await _galleryHostModule.InvokeVoidAsync("setArgs", _runtimeFrame, _story.Path, _runtimeInstance,
                revision, requestId, _argsJson);
        else
            return;
        _sentRevision = revision;
    }

    private static JsonElement ParseArgValue(StoryArgDefinition definition, object? rawValue)
    {
        if (definition.EditorKind == StoryArgEditorKind.Boolean)
            return StoryArgCodec.Serialize(rawValue is bool value ? value : bool.Parse(rawValue?.ToString() ?? "false"));

        string text = Convert.ToString(rawValue, CultureInfo.InvariantCulture) ?? "";
        if (definition.EditorKind is StoryArgEditorKind.Json or StoryArgEditorKind.Preset or StoryArgEditorKind.Number)
        {
            try
            {
                using JsonDocument document = JsonDocument.Parse(text);
                if (definition.EditorKind == StoryArgEditorKind.Number && document.RootElement.ValueKind != JsonValueKind.Number)
                    throw new FormatException($"'{text}'は数値ではありません。");
                return document.RootElement.Clone();
            }
            catch (JsonException) when (definition.EditorKind == StoryArgEditorKind.Preset)
            {
                return StoryArgCodec.Serialize(text);
            }
        }
        return StoryArgCodec.Serialize(text);
    }

    private string? TryRenderDocument(StoryInfo story, string argsJson)
    {
        try
        {
            StoryArgs args = StoryArgs.Parse(argsJson).WithDefaults(story.ArgDefinitions ?? Array.Empty<StoryArgDefinition>());
            using var context = new StoryContext(args: args);
            context.SetServices(Services);
            StoryResult result = global::Luxel.Gallery.UI.StoryPresentation.Build(story, context);
            return result.Kind == StoryResultKind.Markdown
                ? GalleryMarkdownHtml.Render(story, result)
                : null;
        }
        catch
        {
            // 一部のセマンティックプロバイダーには実行中のブラウザーホストが必要なため、ランタイム側でStoryを構築する。
            return null;
        }
    }

    private IReadOnlyList<GalleryNavigationNode> FilteredTree()
    {
        string needle = _search.Trim();
        return needle.Length == 0 ? _navigation.Categories : FilterNodes(_navigation.Categories, needle);
    }

    private IReadOnlyList<GalleryNavigationNode> FilterNodes(
        IReadOnlyList<GalleryNavigationNode> nodes,
        string needle)
    {
        var filtered = new List<GalleryNavigationNode>();
        foreach (GalleryNavigationNode node in nodes)
        {
            bool nodeMatches = node.DisplayLabel.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || node.CanonicalPath.Contains(needle, StringComparison.OrdinalIgnoreCase);
            bool storyMatches = node.Story is { Info: { } story }
                && SearchText(story).Contains(needle, StringComparison.OrdinalIgnoreCase);
            IReadOnlyList<GalleryNavigationNode> children = nodeMatches
                ? node.Children
                : FilterNodes(node.Children, needle);
            if (nodeMatches || storyMatches || children.Count > 0)
                filtered.Add(node with { Children = children });
        }
        return filtered;
    }

    private string SearchText(StoryInfo story)
    {
        var parts = new List<string?>
        {
            story.Path,
            story.Name,
            story.Component,
            story.Source,
            story.ShortDescription,
            story.LongDescription,
            story.CapabilityNote,
            string.Join('\n', Catalog.AliasesFor(story.Path)),
        };
        if (story.ProductionComponent is { } descriptor
            && ControlApiRegistry.Find(descriptor.ControlName) is { } api)
        {
            parts.Add(api.FullName);
            parts.Add(api.Summary);
            foreach (ApiMember member in api.Members)
            {
                parts.Add(member.Name);
                parts.Add(member.Type);
                parts.Add(member.Description);
            }
        }
        return string.Join('\n', parts.Where(part => !string.IsNullOrWhiteSpace(part)));
    }

    private static string StoryHref(string path) => "?story=" + Uri.EscapeDataString(path);

    private static string EmbeddedStoryHref(string path, string argsJson, string? instanceId = null)
    {
        string url = StoryHref(path) + "&embed=1";
        if (!string.IsNullOrWhiteSpace(instanceId)) url += "&instance=" + Uri.EscapeDataString(instanceId);
        return string.IsNullOrWhiteSpace(argsJson) || argsJson == "{}"
            ? url
            : url + "&args=" + Uri.EscapeDataString(argsJson);
    }

    private string ShellClass() => _compact
        ? "gallery-compact"
        : _navigationOpen ? "gallery-shell navigation-open" : "gallery-shell";

    private async Task SetShellThemeAsync(string theme)
    {
        if (theme is not ("system" or "light" or "dark")) return;
        _shellTheme = theme;
        _galleryHostModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./gallery-host.js");
        await _galleryHostModule.InvokeAsync<string>("setShellTheme", theme);
        if (_synchronizePreviewTheme)
            _previewTheme = await _galleryHostModule.InvokeAsync<string>("getResolvedShellTheme");
    }

    private async Task SetPreviewThemeAsync(string theme)
    {
        if (theme is not ("light" or "dark")) return;
        _previewTheme = theme;
        _synchronizePreviewTheme = false;
        _galleryHostModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./gallery-host.js");
        await _galleryHostModule.InvokeVoidAsync("setPreviewTheme", theme);
    }

    private async Task TogglePreviewThemeSynchronizationAsync()
    {
        _synchronizePreviewTheme = !_synchronizePreviewTheme;
        _galleryHostModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./gallery-host.js");
        _previewTheme = await _galleryHostModule.InvokeAsync<string>(
            "setPreviewThemeSynchronization", _synchronizePreviewTheme);
    }

    private async Task ToggleNavigationAsync()
    {
        _navigationOpen = !_navigationOpen;
        await FocusNavigationTargetAsync(_navigationOpen ? "gallery-story-search" : "gallery-navigation-toggle");
    }

    private async Task CloseNavigationAsync()
    {
        if (!_navigationOpen) return;
        _navigationOpen = false;
        await FocusNavigationTargetAsync("gallery-navigation-toggle");
    }

    private Task OnShellKeyDown(KeyboardEventArgs eventArgs)
        => eventArgs.Key == "Escape" && _navigationOpen ? CloseNavigationAsync() : Task.CompletedTask;

    private async Task FocusNavigationTargetAsync(string id)
    {
        _galleryHostModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./gallery-host.js");
        await _galleryHostModule.InvokeVoidAsync("focusElement", id);
    }

    private Task SelectStory(string path)
    {
        _navigationOpen = false;
        if (path != _story.Path && Catalog.Find(path) is not null)
            Navigation.NavigateTo(StoryHref(path), forceLoad: false);
        return Task.CompletedTask;
    }

    private string StoryDisplayLabel()
        => _navigation.FindNode(_story.Path)?.DisplayLabel ?? _story.Name;

    private string StoryCountLabel() => GalleryLabels.StoryCount(_navigation.Stories.Count);

    private void SelectTab(string tab) => _activeTab = tab;
    private void OnTabKeyDown(KeyboardEventArgs eventArgs, string tab)
    {
        int index = Array.IndexOf(Tabs, tab);
        _activeTab = eventArgs.Key switch
        {
            "ArrowLeft" or "ArrowUp" => Tabs[(index + Tabs.Length - 1) % Tabs.Length],
            "ArrowRight" or "ArrowDown" => Tabs[(index + 1) % Tabs.Length],
            "Home" => Tabs[0],
            "End" => Tabs[^1],
            _ => _activeTab,
        };
    }
    private static string TabLabel(string tab) => tab switch
    {
        "Args" => GalleryLabels.Arguments,
        "Output" => GalleryLabels.Output,
        "Source" => GalleryLabels.Source,
        _ => tab,
    };
    private static string TabId(string tab) => "story-tab-" + tab.ToLowerInvariant();
    private static string PanelId(string tab) => "story-panel-" + tab.ToLowerInvariant();
    private string TabClass(string tab) => _activeTab == tab ? "active" : "";
    private static string ArgId(StoryArgDefinition definition) => "story-arg-" + definition.Name;
    private string ArgStep(StoryArgDefinition definition) => definition.Step?.ToString(CultureInfo.InvariantCulture)
        ?? (definition.Type.Contains("float", StringComparison.OrdinalIgnoreCase) || definition.Type.Contains("double", StringComparison.OrdinalIgnoreCase) ? "any" : "1");
    private static string PresetLabel(string option)
    {
        try
        {
            using JsonDocument document = JsonDocument.Parse(option);
            return document.RootElement.ValueKind == JsonValueKind.String
                ? document.RootElement.GetString() ?? ""
                : option;
        }
        catch (JsonException)
        {
            return option;
        }
    }
    private string ArgValue(StoryArgDefinition definition)
    {
        if (!_argValues.TryGetValue(definition.Name, out JsonElement value)) return "";
        if (definition.EditorKind == StoryArgEditorKind.Preset && definition.Options is { Count: > 0 })
        {
            string raw = value.GetRawText();
            if (definition.Options.Contains(raw, StringComparer.Ordinal)) return raw;
        }
        return value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : value.GetRawText();
    }
    private string ArgColorSwatch(StoryArgDefinition definition)
    {
        string value = ArgValue(definition);
        return value.Length >= 7 && value[0] == '#' ? value[..7] : "#000000";
    }
    private bool ArgBoolValue(StoryArgDefinition definition) => _argValues.TryGetValue(definition.Name, out JsonElement value)
        && value.ValueKind is JsonValueKind.True or JsonValueKind.False && value.GetBoolean();
    private static string OutputKindLabel(string kind) => kind switch
    {
        "args" => GalleryLabels.Arguments,
        "event" => "イベント",
        "error" => GalleryLabels.Error,
        _ => kind,
    };
    private string RuntimeStateLabel() => _runtimeState switch { "pass" => "準備完了", "fail" => "失敗", _ => GalleryLabels.Loading };
    private string SourceText() => !string.IsNullOrWhiteSpace(_story.Source) ? _story.Source : "ソースを表示できません。";
    private static string MessageErrors(JsonElement message) => message.TryGetProperty("errors", out JsonElement errors)
        ? string.Join("\n", errors.EnumerateArray().Select(error => error.GetString() ?? error.GetRawText()))
        : "引数の更新に失敗しました。";
    private void AddOutput(string kind, string text)
    {
        _output.Add(new OutputEntry(DateTime.Now.ToString("HH:mm:ss", CultureInfo.InvariantCulture), kind, text));
        if (_output.Count > 200) _output.RemoveAt(0);
    }

    private void ClearSearch() => _search = "";

    private async Task RunStoryAsync(string story, string argsJson)
    {
        try
        {
            await BrowserGalleryApplication.RunAsync(Services, story, argsJson);
        }
        catch
        {
            // BrowserGalleryApplicationが完全な失敗情報をランタイム状態表示へ通知する。
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_runtimeModule is not null)
        {
            try
            {
                await _runtimeModule.InvokeVoidAsync("setLocalReceiver", (object?)null);
                await _runtimeModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already torn down the JS runtime.
            }
        }
        if (_galleryHostModule is not null)
        {
            try
            {
                if (!_compact) await _galleryHostModule.InvokeVoidAsync("dispose");
                await _galleryHostModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already torn down the JS runtime.
            }
        }
        _galleryHostReceiver?.Dispose();
    }

    private sealed record OutputEntry(string Time, string Kind, string Text);

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var values = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (string item in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            string[] pair = item.Split('=', 2);
            values[Uri.UnescapeDataString(pair[0])] = pair.Length == 2 ? Uri.UnescapeDataString(pair[1]) : "";
        }
        return values;
    }
}
