@using System.Globalization
@using System.Runtime.InteropServices.JavaScript
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Luxel.Gallery
@using Luxel.Gallery.Browser
@implements IDisposable
@implements IAsyncDisposable
@inject StoryCatalog Catalog
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (_embedded)
{
    <main class="gallery-embed">
        <canvas id="luxel-canvas" tabindex="0" aria-label="Luxel browser WebGPU"></canvas>
        <div id="status" hidden data-status="loading"></div>
        <div id="error" role="alert" hidden></div>
    </main>
}
else
{
    <div class="@(_compact ? "gallery-compact" : "gallery-shell")">
        @if (!_compact)
        {
        <aside class="gallery-sidebar">
            <header class="gallery-brand">
                <span class="gallery-mark">L</span>
                <span><strong>Luxel</strong><small>Gallery</small></span>
            </header>
            <label class="gallery-search">
                <span aria-hidden="true">⌕</span>
                <input type="search" placeholder="Storyを検索" aria-label="Storyを検索"
                       @bind="_search" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <button type="button" title="検索をクリア" @onclick="ClearSearch">×</button>
                }
            </label>
            <nav class="story-navigation" aria-label="Storyナビゲーション">
                @{ IReadOnlyList<GalleryStoryTreeNode> tree = FilteredTree(); }
                @if (tree.Count > 0)
                {
                    <StoryTree Nodes="tree" ActivePath="@_story.Path" SearchActive="@(!string.IsNullOrWhiteSpace(_search))"
                               StorySelected="SelectStory" />
                }
                else
                {
                    <p class="empty-search">一致するStoryはありません</p>
                }
            </nav>
            <footer class="gallery-sidebar-footer">@Catalog.All.Count 件のStory</footer>
        </aside>
        }

        <main class="@(_documentHtml is not null ? "gallery-main gallery-main-document" : "gallery-main")">
            @if (!_compact)
            {
            <header class="story-toolbar">
                <div>
                    <p>@_story.Component</p>
                    <h1>@_story.Name</h1>
                </div>
                <a class="open-alone" href="@EmbeddedStoryHref(_story.Path, _argsJson)" target="_blank" rel="noopener">キャンバスを開く</a>
            </header>
            }
            @if (_documentHtml is not null)
            {
                <article class="markdown-document">@((MarkupString)_documentHtml)</article>
            }
            else
            {
                <div class="story-workspace" @ref="_workspace">
                    <section class="story-preview" aria-label="Storyプレビュー">
                        @if (_compact)
                        {
                            <canvas id="luxel-canvas" tabindex="0" aria-label="Luxel browser WebGPU"></canvas>
                            <div id="status" hidden data-status="loading"></div>
                            <div id="error" role="alert" hidden></div>
                        }
                        else
                        {
                            <iframe @key="_runtimeUrl" @ref="_runtimeFrame" class="story-runtime-frame" src="@_runtimeUrl"
                                    title="@_story.Path" allow="autoplay; clipboard-read; clipboard-write"></iframe>
                        }
                    </section>
                    <div class="story-splitter" @ref="_splitter" role="separator" tabindex="0"
                         aria-label="Storyプレビューと詳細の大きさを変更" aria-orientation="horizontal"
                         aria-valuemin="150" aria-valuemax="800" aria-valuenow="260"></div>
                    <section class="story-lower-panel" aria-label="Storyの詳細">
                        <div class="story-tabs" role="tablist" aria-label="Storyの詳細">
                            @foreach (string tab in Tabs)
                            {
                                <button id="@TabId(tab)" type="button" role="tab"
                                        aria-selected="@(_activeTab == tab ? "true" : "false")" aria-controls="@PanelId(tab)"
                                        tabindex="@(_activeTab == tab ? 0 : -1)" class="@TabClass(tab)"
                                        @onclick="() => SelectTab(tab)" @onkeydown="eventArgs => OnTabKeyDown(eventArgs, tab)">@TabLabel(tab)</button>
                            }
                        </div>
                        <div id="@PanelId(_activeTab)" class="story-tab-panel" role="tabpanel"
                             aria-labelledby="@TabId(_activeTab)" tabindex="0">
                            @if (_activeTab == "Args")
                            {
                                @if (_argDefinitions.Count == 0)
                                {
                                    <p class="panel-empty">このStoryには編集可能な引数がありません。</p>
                                }
                                else
                                {
                                    <div class="args-table">
                                        @foreach (StoryArgDefinition definition in _argDefinitions)
                                        {
                                            <div class="arg-row">
                                                <label for="@ArgId(definition)">
                                                    <strong>@definition.Name</strong>
                                                    <small>@definition.Type</small>
                                                    @if (!string.IsNullOrWhiteSpace(definition.Description))
                                                    {
                                                        <span>@definition.Description</span>
                                                    }
                                                </label>
                                                @if (definition.Options is { Count: > 0 })
                                                {
                                                    <select id="@ArgId(definition)" value="@ArgValue(definition)"
                                                            @onchange="eventArgs => UpdateArgAsync(definition, eventArgs.Value)">
                                                        @foreach (string option in definition.Options)
                                                        {
                                                            <option value="@option">@option</option>
                                                        }
                                                    </select>
                                                }
                                                else if (IsBoolean(definition))
                                                {
                                                    <input id="@ArgId(definition)" type="checkbox" checked="@ArgBoolValue(definition)"
                                                           @onchange="eventArgs => UpdateArgAsync(definition, eventArgs.Value)" />
                                                }
                                                else
                                                {
                                                    <input id="@ArgId(definition)" type="@(IsNumeric(definition) ? "number" : "text")"
                                                           value="@ArgValue(definition)" min="@definition.Min" max="@definition.Max" step="@ArgStep(definition)"
                                                           @onchange="eventArgs => UpdateArgAsync(definition, eventArgs.Value)" />
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else if (_activeTab == "Output")
                            {
                                <div class="output-status" data-runtime-state="@_runtimeState">
                                    <span class="runtime-dot" aria-hidden="true"></span>
                                    <strong>@RuntimeStateLabel()</strong>
                                    @if (!string.IsNullOrWhiteSpace(_runtimeSummary))
                                    {
                                        <span>@_runtimeSummary</span>
                                    }
                                </div>
                                @if (_output.Count == 0)
                                {
                                    <p class="panel-empty">ランタイムのイベントとエラーがここに表示されます。</p>
                                }
                                else
                                {
                                    <ol class="output-list" aria-live="polite">
                                        @foreach (OutputEntry entry in _output)
                                        {
                                            <li class="output-@entry.Kind"><time>@entry.Time</time><strong>@OutputKindLabel(entry.Kind)</strong><pre>@entry.Text</pre></li>
                                        }
                                    </ol>
                                }
                            }
                            else
                            {
                                @if (_sampleBundle is not null)
                                {
                                    <div class="source-context">
                                        <strong>このサンプルを実行 · @_sampleBundle.CopyLevel</strong>
                                        @if (!string.IsNullOrWhiteSpace(_sampleBundle.RunCommand))
                                        {
                                            <code>@_sampleBundle.RunCommand</code>
                                        }
                                        <span>@string.Join(" · ", _sampleBundle.Files.Select(file => file.Path))</span>
                                    </div>
                                }
                                <pre class="story-source"><code>@SourceText()</code></pre>
                            }
                        </div>
                    </section>
                </div>
            }
        </main>
    </div>
}

@code {
    private static readonly string[] Tabs = ["Args", "Output", "Source"];
    private bool _started;
    private bool _embedded;
    private bool _compact;
    private string _argsJson = "{}";
    private string _search = "";
    private string? _documentHtml;
    private string _runtimeUrl = "";
    private string _runtimeInstance = "";
    private string _activeTab = "Args";
    private string _runtimeState = "loading";
    private string _runtimeSummary = "Storyランタイムを待機しています。";
    private int _revision;
    private StoryInfo _story = null!;
    private SampleBundleInfo? _sampleBundle;
    private IReadOnlyList<StoryArgDefinition> _argDefinitions = Array.Empty<StoryArgDefinition>();
    private Dictionary<string, JsonElement> _argValues = new(StringComparer.Ordinal);
    private readonly List<OutputEntry> _output = [];
    private ElementReference _workspace;
    private ElementReference _runtimeFrame;
    private ElementReference _splitter;
    private IJSObjectReference? _galleryHostModule;
    private IJSObjectReference? _runtimeModule;
    private DotNetObjectReference<App>? _galleryHostReceiver;
    private JSObject? _browserHostModule;
    private JSObject? _slangModule;
    private JSObject? _webGpuModule;
    private JSObject? _audioModule;

    protected override void OnInitialized()
    {
        LoadLocation(Navigation.Uri);
        if (!_embedded) Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_embedded || _compact)
        {
            if (!firstRender || _started) return;
            _started = true;
            if (_compact)
            {
                _galleryHostReceiver = DotNetObjectReference.Create(this);
                _runtimeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./main.js");
                await _runtimeModule.InvokeVoidAsync("setLocalReceiver", _galleryHostReceiver);
                _galleryHostModule = await JS.InvokeAsync<IJSObjectReference>("import", "./gallery-host.js");
                await _galleryHostModule.InvokeVoidAsync("wireSplitter", _workspace, _splitter);
            }
            _browserHostModule = await JSHost.ImportAsync("luxel-browser-host", "../main.js");
            _slangModule = await JSHost.ImportAsync("luxel-slang", "../slang-browser.js");
            _webGpuModule = await JSHost.ImportAsync("./luxel-webgpu-browser.js", "../luxel-webgpu-browser.js");
            _audioModule = await JSHost.ImportAsync("./luxel-audio-browser.js", "../luxel-audio-browser.js");
            _ = RunStoryAsync(_story.Path, _argsJson);
            return;
        }

        _galleryHostModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./gallery-host.js");
        if (_galleryHostReceiver is null)
        {
            _galleryHostReceiver = DotNetObjectReference.Create(this);
            await _galleryHostModule.InvokeVoidAsync("initialize", _galleryHostReceiver);
        }
        if (_documentHtml is null)
        {
            await _galleryHostModule.InvokeVoidAsync("configure", _runtimeFrame, _story.Path, _runtimeInstance);
            await _galleryHostModule.InvokeVoidAsync("wireSplitter", _workspace, _splitter);
        }
    }

    private void LoadLocation(string location)
    {
        Uri uri = Navigation.ToAbsoluteUri(location);
        Dictionary<string, string> query = ParseQuery(uri.Query);
        _embedded = query.GetValueOrDefault("embed") is "1" or "true";
        _compact = !_embedded && query.GetValueOrDefault("compact") is "1" or "true";
        string? requested = query.GetValueOrDefault("story");
        _story = requested is null ? Catalog.All[0] : Catalog.Find(requested)
            ?? throw new InvalidOperationException($"Unknown browser story '{requested}'.");
        _argsJson = query.GetValueOrDefault("args") ?? "{}";
        _documentHtml = _embedded ? null : TryRenderDocument(_story, _argsJson);
        _argDefinitions = (_story.ArgDefinitions ?? Array.Empty<StoryArgDefinition>())
            .OrderBy(definition => definition.Order).ThenBy(definition => definition.Name, StringComparer.Ordinal).ToArray();
        StoryArgs canonicalArgs = StoryArgs.Parse(_argsJson).WithDefaults(_argDefinitions);
        _argValues = canonicalArgs.Values.ToDictionary(pair => pair.Key, pair => pair.Value.Clone(), StringComparer.Ordinal);
        _argsJson = canonicalArgs.ToJson();
        _sampleBundle = SampleBundleRegistry.Find(_story.SampleBundle);
        _runtimeInstance = Guid.NewGuid().ToString("N");
        _revision = 0;
        _runtimeState = "loading";
        _runtimeSummary = "Storyランタイムを待機しています。";
        _output.Clear();
        _runtimeUrl = _embedded || _compact || _documentHtml is not null
            ? ""
            : EmbeddedStoryHref(_story.Path, _argsJson, _runtimeInstance);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            LoadLocation(args.Location);
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task OnRuntimeMessage(JsonElement message)
    {
        string type = message.GetProperty("type").GetString() ?? "event";
        if (message.TryGetProperty("revision", out JsonElement revision) && revision.TryGetInt32(out int runtimeRevision))
            _revision = Math.Max(_revision, runtimeRevision);
        if (message.TryGetProperty("args", out JsonElement args) && args.ValueKind == JsonValueKind.Object)
        {
            StoryArgs snapshot = new(args.EnumerateObject().Select(property => KeyValuePair.Create(property.Name, property.Value)));
            _argValues = snapshot.Values.ToDictionary(pair => pair.Key, pair => pair.Value.Clone(), StringComparer.Ordinal);
            _argsJson = snapshot.ToJson();
        }

        switch (type)
        {
            case "ready":
                _runtimeState = message.TryGetProperty("state", out JsonElement readyState) ? readyState.GetString() ?? "pass" : "pass";
                _runtimeSummary = message.TryGetProperty("summary", out JsonElement summary) ? summary.GetString() ?? "ランタイムの準備が完了しました。" : "ランタイムの準備が完了しました。";
                break;
            case "args-changed":
                _runtimeState = "pass";
                AddOutput("args", message.TryGetProperty("source", out JsonElement source)
                    ? $"引数を変更しました（{source.GetString()}）。" : "引数を変更しました。");
                break;
            case "arg-error":
                _runtimeState = "fail";
                AddOutput("error", MessageErrors(message));
                _activeTab = "Output";
                break;
            case "event":
                AddOutput("event", message.TryGetProperty("entry", out JsonElement entry) ? entry.GetRawText() : "イベント");
                break;
            case "story-error":
                _runtimeState = "fail";
                _runtimeSummary = message.TryGetProperty("error", out JsonElement error) ? error.GetString() ?? "Storyの実行に失敗しました。" : "Storyの実行に失敗しました。";
                AddOutput("error", _runtimeSummary);
                _activeTab = "Output";
                break;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task UpdateArgAsync(StoryArgDefinition definition, object? rawValue)
    {
        try
        {
            _argValues[definition.Name] = ParseArgValue(definition, rawValue);
            _argsJson = new StoryArgs(_argValues).ToJson();
            int revision = ++_revision;
            string requestId = $"args-{revision}-{Guid.NewGuid():N}";
            if (_compact && _runtimeModule is not null)
                await _runtimeModule.InvokeVoidAsync("setArgs", revision, requestId, _argsJson);
            else if (_galleryHostModule is not null)
                await _galleryHostModule.InvokeVoidAsync("setArgs", _runtimeFrame, _story.Path, _runtimeInstance,
                    revision, requestId, _argsJson);
        }
        catch (Exception error) when (error is FormatException or JsonException or OverflowException)
        {
            _runtimeState = "fail";
            AddOutput("error", $"{definition.Name}: {error.Message}");
            _activeTab = "Output";
        }
    }

    private static JsonElement ParseArgValue(StoryArgDefinition definition, object? rawValue)
    {
        if (IsBoolean(definition)) return StoryArgCodec.Serialize(rawValue is bool value ? value : bool.Parse(rawValue?.ToString() ?? "false"));
        string text = Convert.ToString(rawValue, CultureInfo.InvariantCulture) ?? "";
        if (!IsNumeric(definition)) return StoryArgCodec.Serialize(text);
        using JsonDocument document = JsonDocument.Parse(text);
        if (document.RootElement.ValueKind != JsonValueKind.Number)
            throw new FormatException($"'{text}'は数値ではありません。");
        return document.RootElement.Clone();
    }

    private string? TryRenderDocument(StoryInfo story, string argsJson)
    {
        if (story.ResultBuild is null) return null;
        try
        {
            StoryArgs args = StoryArgs.Parse(argsJson).WithDefaults(story.ArgDefinitions ?? Array.Empty<StoryArgDefinition>());
            using var context = new StoryContext(args: args);
            context.SetServices(Services);
            StoryResult result = story.BuildResult(context);
            return result.Kind == StoryResultKind.Markdown
                ? GalleryMarkdownHtml.Render(story, result)
                : null;
        }
        catch
        {
            // 一部のセマンティックプロバイダーには実行中のブラウザーホストが必要なため、ランタイム側でStoryを構築する。
            return null;
        }
    }

    private IReadOnlyList<GalleryStoryTreeNode> FilteredTree()
    {
        string needle = _search.Trim();
        IEnumerable<StoryInfo> stories = Catalog.All;
        if (needle.Length > 0)
            stories = stories.Where(story => SearchText(story).Contains(needle, StringComparison.OrdinalIgnoreCase));
        return GalleryStoryTree.Build(stories);
    }

    private string SearchText(StoryInfo story)
        => string.Join('\n', story.Path, story.Name, story.Component, story.Source ?? "", story.CapabilityNote ?? "",
            string.Join('\n', Catalog.AliasesFor(story.Path)));

    private static string StoryHref(string path) => "?story=" + Uri.EscapeDataString(path);

    private static string EmbeddedStoryHref(string path, string argsJson, string? instanceId = null)
    {
        string url = StoryHref(path) + "&embed=1";
        if (!string.IsNullOrWhiteSpace(instanceId)) url += "&instance=" + Uri.EscapeDataString(instanceId);
        return string.IsNullOrWhiteSpace(argsJson) || argsJson == "{}"
            ? url
            : url + "&args=" + Uri.EscapeDataString(argsJson);
    }

    private void SelectStory(StoryInfo story)
    {
        if (story.Path == _story.Path) return;
        Navigation.NavigateTo(StoryHref(story.Path), forceLoad: false);
    }

    private void SelectTab(string tab) => _activeTab = tab;
    private void OnTabKeyDown(KeyboardEventArgs eventArgs, string tab)
    {
        int index = Array.IndexOf(Tabs, tab);
        _activeTab = eventArgs.Key switch
        {
            "ArrowLeft" or "ArrowUp" => Tabs[(index + Tabs.Length - 1) % Tabs.Length],
            "ArrowRight" or "ArrowDown" => Tabs[(index + 1) % Tabs.Length],
            "Home" => Tabs[0],
            "End" => Tabs[^1],
            _ => _activeTab,
        };
    }
    private static string TabLabel(string tab) => tab switch
    {
        "Args" => "引数",
        "Output" => "出力",
        "Source" => "ソース",
        _ => tab,
    };
    private static string TabId(string tab) => "story-tab-" + tab.ToLowerInvariant();
    private static string PanelId(string tab) => "story-panel-" + tab.ToLowerInvariant();
    private string TabClass(string tab) => _activeTab == tab ? "active" : "";
    private static string ArgId(StoryArgDefinition definition) => "story-arg-" + definition.Name;
    private static bool IsBoolean(StoryArgDefinition definition) => definition.Type is "bool" or "boolean" or "System.Boolean";
    private static bool IsNumeric(StoryArgDefinition definition) => definition.Type.ToLowerInvariant() is
        "byte" or "sbyte" or "short" or "ushort" or "int" or "uint" or "long" or "ulong" or
        "float" or "double" or "decimal" or "system.int32" or "system.int64" or "system.single" or "system.double" or "system.decimal";
    private string ArgStep(StoryArgDefinition definition) => definition.Step?.ToString(CultureInfo.InvariantCulture)
        ?? (definition.Type.Contains("float", StringComparison.OrdinalIgnoreCase) || definition.Type.Contains("double", StringComparison.OrdinalIgnoreCase) ? "any" : "1");
    private string ArgValue(StoryArgDefinition definition) => _argValues.TryGetValue(definition.Name, out JsonElement value)
        ? value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : value.GetRawText()
        : "";
    private bool ArgBoolValue(StoryArgDefinition definition) => _argValues.TryGetValue(definition.Name, out JsonElement value)
        && value.ValueKind is JsonValueKind.True or JsonValueKind.False && value.GetBoolean();
    private static string OutputKindLabel(string kind) => kind switch
    {
        "args" => "引数",
        "event" => "イベント",
        "error" => "エラー",
        _ => kind,
    };
    private string RuntimeStateLabel() => _runtimeState switch { "pass" => "準備完了", "fail" => "失敗", _ => "読み込み中" };
    private string SourceText() => !string.IsNullOrWhiteSpace(_story.Source) ? _story.Source
        : _sampleBundle is null
            ? "ソースを表示できません。Galleryハーネスが必要で、単独実行用のサンプルバンドルは登録されていません。"
            : $"ソースを表示できません。このサンプルを実行してください（{_sampleBundle.CopyLevel}）：{_sampleBundle.RunCommand}";
    private static string MessageErrors(JsonElement message) => message.TryGetProperty("errors", out JsonElement errors)
        ? string.Join("\n", errors.EnumerateArray().Select(error => error.GetString() ?? error.GetRawText()))
        : "引数の更新に失敗しました。";
    private void AddOutput(string kind, string text)
    {
        _output.Add(new OutputEntry(DateTime.Now.ToString("HH:mm:ss", CultureInfo.InvariantCulture), kind, text));
        if (_output.Count > 200) _output.RemoveAt(0);
    }

    private void ClearSearch() => _search = "";

    private async Task RunStoryAsync(string story, string argsJson)
    {
        try
        {
            await BrowserGalleryApplication.RunAsync(Services, story, argsJson);
        }
        catch
        {
            // BrowserGalleryApplicationが完全な失敗情報をランタイム状態表示へ通知する。
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_runtimeModule is not null)
        {
            try
            {
                await _runtimeModule.InvokeVoidAsync("setLocalReceiver", (object?)null);
                await _runtimeModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already torn down the JS runtime.
            }
        }
        if (_galleryHostModule is not null)
        {
            try
            {
                if (!_compact) await _galleryHostModule.InvokeVoidAsync("dispose");
                await _galleryHostModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already torn down the JS runtime.
            }
        }
        _galleryHostReceiver?.Dispose();
    }

    private sealed record OutputEntry(string Time, string Kind, string Text);

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var values = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (string item in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            string[] pair = item.Split('=', 2);
            values[Uri.UnescapeDataString(pair[0])] = pair.Length == 2 ? Uri.UnescapeDataString(pair[1]) : "";
        }
        return values;
    }
}
