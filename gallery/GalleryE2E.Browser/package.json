{
  "name": "luxel-gallery-e2e-browser",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright coverage for browser-WASM Gallery stories.",
  "scripts": {
    "prepare:gallery": "dotnet publish ../GalleryBrowser/GalleryBrowser.csproj -c Release -p:WasmBuildNative=true -o ../../artifacts/gallery-browser",
    "run": "npm run prepare:gallery && playwright test",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@luxel/browser-e2e-support": "file:../../eng/browser-e2e-support"
  }
}
