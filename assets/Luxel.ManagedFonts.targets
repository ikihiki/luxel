<Project>
  <!--
    Windows 標準フォントがないテスト/CI向けの決定的な fallback。
    Google Fonts の固定コミットから Latin と日本語の Noto Sans を取得し、SHA-256 を検証する。
    Windows では VectorFont が従来どおりシステムフォントを優先するため golden の字形は変えない。
  -->
  <PropertyGroup>
    <LuxelManagedFontsRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tools\fonts'))</LuxelManagedFontsRoot>
    <LuxelManagedFontDownloadRoot>$(BaseIntermediateOutputPath)luxel-font-downloads</LuxelManagedFontDownloadRoot>

    <NotoSansCommit>2984c575fdce412ee02b2baaba67672b9a9434d8</NotoSansCommit>
    <NotoSansSha256>BFB7BB691513F12E734DC346C03A03F784912432D7E3FA8E56EFCF906FE86B3D</NotoSansSha256>
    <NotoSansUrl>https://raw.githubusercontent.com/google/fonts/$(NotoSansCommit)/ofl/notosans/NotoSans%5Bwdth,wght%5D.ttf</NotoSansUrl>
    <NotoSansLicenseUrl>https://raw.githubusercontent.com/google/fonts/$(NotoSansCommit)/ofl/notosans/OFL.txt</NotoSansLicenseUrl>
    <NotoSansDir>$([System.IO.Path]::Combine('$(LuxelManagedFontsRoot)', 'NotoSans', '$(NotoSansCommit)'))</NotoSansDir>
    <NotoSansPath>$([System.IO.Path]::Combine('$(NotoSansDir)', 'NotoSans.ttf'))</NotoSansPath>
    <NotoSansLicensePath>$([System.IO.Path]::Combine('$(NotoSansDir)', 'OFL.txt'))</NotoSansLicensePath>

    <NotoSansJpCommit>295d98a7a0c17c68f1341eaeea354e7960ea70d3</NotoSansJpCommit>
    <NotoSansJpSha256>C2F3B4D463500A2DDCD3849CDED1FCEEB9FD6D1C32E6CBECD568453BA50FC68F</NotoSansJpSha256>
    <NotoSansJpUrl>https://raw.githubusercontent.com/google/fonts/$(NotoSansJpCommit)/ofl/notosansjp/NotoSansJP%5Bwght%5D.ttf</NotoSansJpUrl>
    <NotoSansJpLicenseUrl>https://raw.githubusercontent.com/google/fonts/$(NotoSansJpCommit)/ofl/notosansjp/OFL.txt</NotoSansJpLicenseUrl>
    <NotoSansJpDir>$([System.IO.Path]::Combine('$(LuxelManagedFontsRoot)', 'NotoSansJP', '$(NotoSansJpCommit)'))</NotoSansJpDir>
    <NotoSansJpPath>$([System.IO.Path]::Combine('$(NotoSansJpDir)', 'NotoSansJP.ttf'))</NotoSansJpPath>
    <NotoSansJpLicensePath>$([System.IO.Path]::Combine('$(NotoSansJpDir)', 'OFL.txt'))</NotoSansJpLicensePath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(NotoSansPath)">
      <Link>fonts/NotoSans.ttf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NotoSansJpPath)">
      <Link>fonts/NotoSansJP.ttf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NotoSansLicensePath)">
      <Link>licenses/NotoSans-OFL.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NotoSansJpLicensePath)">
      <Link>licenses/NotoSansJP-OFL.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="AcquireLuxelManagedFonts" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_NotoSansDownloadDir>$([System.IO.Path]::Combine('$(LuxelManagedFontDownloadRoot)', 'NotoSans'))</_NotoSansDownloadDir>
      <_NotoSansJpDownloadDir>$([System.IO.Path]::Combine('$(LuxelManagedFontDownloadRoot)', 'NotoSansJP'))</_NotoSansJpDownloadDir>
      <_NotoSansDownloadPath>$([System.IO.Path]::Combine('$(_NotoSansDownloadDir)', 'NotoSans[wdth,wght].ttf'))</_NotoSansDownloadPath>
      <_NotoSansJpDownloadPath>$([System.IO.Path]::Combine('$(_NotoSansJpDownloadDir)', 'NotoSansJP[wght].ttf'))</_NotoSansJpDownloadPath>
    </PropertyGroup>
    <MakeDir Directories="$(NotoSansDir);$(NotoSansJpDir);$(_NotoSansDownloadDir);$(_NotoSansJpDownloadDir)" />

    <DownloadFile Condition="!Exists('$(NotoSansPath)')" SourceUrl="$(NotoSansUrl)" DestinationFolder="$(_NotoSansDownloadDir)" Retries="3" RetryDelayMilliseconds="1000" />
    <Copy Condition="!Exists('$(NotoSansPath)')" SourceFiles="$(_NotoSansDownloadPath)" DestinationFiles="$(NotoSansPath)" />
    <DownloadFile Condition="!Exists('$(NotoSansLicensePath)')" SourceUrl="$(NotoSansLicenseUrl)" DestinationFolder="$(NotoSansDir)" Retries="3" RetryDelayMilliseconds="1000" />

    <DownloadFile Condition="!Exists('$(NotoSansJpPath)')" SourceUrl="$(NotoSansJpUrl)" DestinationFolder="$(_NotoSansJpDownloadDir)" Retries="3" RetryDelayMilliseconds="1000" />
    <Copy Condition="!Exists('$(NotoSansJpPath)')" SourceFiles="$(_NotoSansJpDownloadPath)" DestinationFiles="$(NotoSansJpPath)" />
    <DownloadFile Condition="!Exists('$(NotoSansJpLicensePath)')" SourceUrl="$(NotoSansJpLicenseUrl)" DestinationFolder="$(NotoSansJpDir)" Retries="3" RetryDelayMilliseconds="1000" />

    <Error Condition="!Exists('$(NotoSansPath)')" Text="Noto Sans を取得できませんでした: $(NotoSansUrl)" />
    <Error Condition="!Exists('$(NotoSansJpPath)')" Text="Noto Sans JP を取得できませんでした: $(NotoSansJpUrl)" />
    <Error Condition="!Exists('$(NotoSansLicensePath)') or !Exists('$(NotoSansJpLicensePath)')" Text="Noto フォントの OFL ライセンスを取得できませんでした。" />
    <GetFileHash Files="$(NotoSansPath);$(NotoSansJpPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_ManagedFontHash" />
    </GetFileHash>
    <Error Condition="'%(_ManagedFontHash.Filename)' == 'NotoSans' and '%(_ManagedFontHash.FileHash)' != '$(NotoSansSha256)'" Text="NotoSans.ttf の SHA-256 が一致しません。$(NotoSansPath) を削除して再ビルドしてください。" />
    <Error Condition="'%(_ManagedFontHash.Filename)' == 'NotoSansJP' and '%(_ManagedFontHash.FileHash)' != '$(NotoSansJpSha256)'" Text="NotoSansJP.ttf の SHA-256 が一致しません。$(NotoSansJpPath) を削除して再ビルドしてください。" />
  </Target>
</Project>
