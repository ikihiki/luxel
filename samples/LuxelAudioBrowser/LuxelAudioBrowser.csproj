<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmBuildNative>true</WasmBuildNative>
    <LuxelBrowserWasm>true</LuxelBrowserWasm>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Audio\Luxel.Audio\Luxel.Audio.csproj" />
    <ProjectReference Include="..\..\src\Audio\Luxel.Audio.Browser\Luxel.Audio.Browser.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\Audio\Luxel.Audio.Browser\wwwroot\luxel-audio-browser.js"
             Link="wwwroot\luxel-audio-browser.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
