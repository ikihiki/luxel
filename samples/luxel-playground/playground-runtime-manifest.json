{
  "bundleId": "luxel-playground-browser-v2",
  "protocol": "luxel-playground",
  "protocolVersion": 2,
  "workspaceSchemaVersion": 2,
  "entryUrl": "./",
  "isolation": "iframe-recreate-per-run",
  "workerIsolation": true,
  "workspaceResources": {
    "sources": ["workspace", "http", "https"],
    "imageDecoder": "ImageSharp",
    "gpuSteps": true,
    "pump": "render-loop"
  },
  "slang": {
    "version": "2026.14",
    "target": "wgsl",
    "compiler": "official-wasm",
    "languageServices": ["diagnostics", "completion", "hover"],
    "assetManifest": "./slang/manifest.json"
  },
  "defaultSource": "return Kit.Button(_ => Log(\"Button clicked.\"), \"Click me\");",
  "messagesFromParent": ["run"],
  "messagesFromRuntime": ["ready", "diagnostics", "output", "runtime-error", "run-result"]
}
