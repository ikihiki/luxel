<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LuxelCavern — スタンドアロン実行ファイル (capstone ①)。実窓・スワップチェーン提示・入力の結線だけを持つ
    薄い層で、ゲームロジックは LuxelCavern.Core にある。ToDo 19 の publish 検証の本丸。
    RID は publish 時に -r win-x64 で指定する (csproj には固定しない — dotnet run/build を軽く保つ)。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Typography\Luxel.Typography.csproj" />
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Typography.TwoD\Luxel.Typography.TwoD.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\Luxel.Mathematics\Luxel.Mathematics.csproj" />
    <Using Include="Luxel.Mathematics" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <AssemblyName>LuxelCavern</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Platform\Luxel.Platform.Windows\Luxel.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Graphics\Luxel.Graphics.csproj" />
    <ProjectReference Include="..\LuxelCavern.Core\LuxelCavern.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Platform\Luxel.Platform\Luxel.Platform.csproj" />
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Graphics.Vulkan\Luxel.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Graphics.DirectX12\Luxel.Graphics.DirectX12.csproj" />
    <!-- 実時間ゲームループ (GameScene/LuxelHostBuilder) + 入力 + パーティクル -->
    <ProjectReference Include="..\..\..\src\Framework\Luxel.Framework.Game.Native\Luxel.Framework.Game.Native.csproj" />
    <ProjectReference Include="..\..\..\src\Framework\Luxel.Framework.Game\Luxel.Framework.Game.csproj" />
    <ProjectReference Include="..\..\..\src\Input\Luxel.Input\Luxel.Input.csproj" />
    <ProjectReference Include="..\..\..\src\Particles\Luxel.Particles\Luxel.Particles.csproj" />
    <ProjectReference Include="..\..\..\src\Particles\Luxel.Particles.TwoD\Luxel.Particles.TwoD.csproj" />
    <!-- セーブの実 IO (PhysicalFileStore を %APPDATA% に向ける) -->
    <ProjectReference Include="..\..\..\src\Framework\Luxel.Settings\Luxel.Settings.csproj" />
    <!-- DevTools 結線 (WithDevTools でブラウザ/内蔵版に診断/フレームを配信) -->
    <ProjectReference Include="..\..\..\src\DevTools\Luxel.Framework.DevTools\Luxel.Framework.DevTools.csproj" />
  </ItemGroup>

  <!-- 同梱アセット (フォント等) を exe 隣へコピー + publish にも含める。cwd 非依存ロードの前提。 -->
  <ItemGroup>
    <Content Include="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 埋め込み本文フォントの再配布ライセンス。 -->
  <ItemGroup>
    <Content Include="..\..\..\assets\fonts\BIZUDGothic-OFL.txt">
      <Link>licenses\BIZUDGothic-OFL.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Slang シェーダ (GpuDeviceRasterizer2D 用) を出力/publish の shaders/ へ。targets 側で publish コピーも面倒を見る。 -->
  <Import Project="..\..\..\shaders\Luxel.Shaders.targets" />

  <ItemGroup>
    <Using Include="Luxel.Graphics" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Luxel.Platform" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Luxel.Platform.Windows" />
  </ItemGroup>
</Project>
