<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LuxelCavern.Core — capstone ① のゲームロジック (Platform/実窓に非依存の純ロジック)。
    タイトル画面 UI の組み立て・ゲーム状態機械・(将来) GameScene 派生シーンを置く。
    Gallery が本アセンブリを参照して Game/Cavern ストーリーとして play/golden を維持する予定 (ToDo 19)。
  -->
  <!-- 純ロジック (依存は UI/Controls/TwoD/Typography = すべて net10.0)。net10.0 にして
       テスト (Luxel.Tests) と Gallery/exe の両方から参照可能にする。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Shared\Luxel.Mathematics\Luxel.Mathematics.csproj" />
    <Using Include="Luxel.Mathematics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\DevTools\Luxel.Diagnostics\Luxel.Diagnostics.csproj" />
  </ItemGroup>

  <PropertyGroup>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\UI\Luxel.UI\Luxel.UI.csproj" />
    <ProjectReference Include="..\..\..\src\UI\Luxel.Controls\Luxel.Controls.csproj" />
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Graphics.TwoD\Luxel.Graphics.TwoD.csproj" />
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Typography\Luxel.Typography.csproj" />
    <!-- セーブの読み書き抽象 (IFileStore)。%APPDATA% への実 IO は exe が PhysicalFileStore で渡す。 -->
    <ProjectReference Include="..\..\..\src\Framework\Luxel.Settings\Luxel.Settings.csproj" />
    <!-- ゲームオーディオ (BGM/SE)。実バックエンド (XAudio2) は exe が UseAudio で注入、テストは Null。 -->
    <ProjectReference Include="..\..\..\src\Audio\Luxel.Audio\Luxel.Audio.csproj" />
    <!-- レベル (.tmj) の読み込みを ResourceSystem 経由で管理する (キャッシュ/型付きノード/リロード)。 -->
    <ProjectReference Include="..\..\..\src\Resources\Luxel.Resources\Luxel.Resources.csproj" />
    <!-- DevTools 用オーバーレイ (パーティクル gizmo)。gizmo/DebugDraw/DevStats は TwoD/Luxel 経由。 -->
    <ProjectReference Include="..\..\..\src\Particles\Luxel.Particles\Luxel.Particles.csproj" />
    <ProjectReference Include="..\..\..\src\Particles\Luxel.Particles.TwoD\Luxel.Particles.TwoD.csproj" />
    <!-- キーバインド設定 (KeyCode / InputAction の再割当ロジック)。 -->
    <ProjectReference Include="..\..\..\src\Input\Luxel.Input\Luxel.Input.csproj" />
  </ItemGroup>

  <!-- ゲームアセットを Core.dll へ埋め込む (ResourceSystem 経由でロード)。レベル (.tmj) + 本文フォント (.ttf)。
       埋め込みにより single-file publish でも loose ファイル (BaseDirectory 依存) に頼らず起動できる。 -->
  <ItemGroup>
    <EmbeddedResource Include="levels\cavern1.tmj" />
    <EmbeddedResource Include="..\..\..\assets\fonts\BIZUDGothic-Regular.ttf">
      <Link>assets\fonts\BIZUDGothic-Regular.ttf</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
