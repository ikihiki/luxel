<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LuxelCavern.Core — capstone ① のゲームロジック (Platform/実窓に非依存の純ロジック)。
    タイトル画面 UI の組み立て・ゲーム状態機械・(将来) GameScene 派生シーンを置く。
    Gallery が本アセンブリを参照して Game/Cavern ストーリーとして play/golden を維持する予定 (ToDo 19)。
  -->
  <!-- 純ロジック (依存は UI/Controls/TwoD/Typography = すべて net10.0)。net10.0 にして
       テスト (Luxel.Tests) と Gallery/exe の両方から参照可能にする。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Luxel.UI\Luxel.UI.csproj" />
    <ProjectReference Include="..\..\..\src\Luxel.Controls\Luxel.Controls.csproj" />
    <ProjectReference Include="..\..\..\src\Luxel.TwoD\Luxel.TwoD.csproj" />
    <ProjectReference Include="..\..\..\src\Luxel.Typography\Luxel.Typography.csproj" />
    <!-- セーブの読み書き抽象 (IFileStore)。%APPDATA% への実 IO は exe が PhysicalFileStore で渡す。 -->
    <ProjectReference Include="..\..\..\src\Luxel.Settings\Luxel.Settings.csproj" />
    <!-- ゲームオーディオ (BGM/SE)。実バックエンド (XAudio2) は exe が UseAudio で注入、テストは Null。 -->
    <ProjectReference Include="..\..\..\src\Luxel.Audio\Luxel.Audio.csproj" />
    <!-- レベル (.tmj) の読み込みを ResourceSystem 経由で管理する (キャッシュ/型付きノード/リロード)。 -->
    <ProjectReference Include="..\..\..\src\Luxel.Resources\Luxel.Resources.csproj" />
    <!-- DevTools 用オーバーレイ (パーティクル gizmo)。gizmo/DebugDraw/DevStats は TwoD/Luxel 経由。 -->
    <ProjectReference Include="..\..\..\src\Luxel.Particles\Luxel.Particles.csproj" />
    <ProjectReference Include="..\..\..\src\Luxel.Particles.TwoD\Luxel.Particles.TwoD.csproj" />
  </ItemGroup>

  <!-- Tiled (.tmj) レベルを Core.dll へ埋め込む (exe/Gallery/テストが同じレベルを持つ・publish 追加コピー不要)。 -->
  <ItemGroup>
    <EmbeddedResource Include="levels\cavern1.tmj" />
  </ItemGroup>

</Project>
