<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmBuildNative>true</WasmBuildNative>
    <LuxelBrowserWasm>true</LuxelBrowserWasm>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\CanonicalTriangleRecipe.cs" Link="CanonicalTriangleRecipe.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Luxel.Gallery.Stories.CoreUi\Luxel.Gallery.Stories.CoreUi.csproj" />
    <ProjectReference Include="..\..\src\Luxel.Controls\Luxel.Controls.csproj" />
    <ProjectReference Include="..\..\src\Luxel.Graphics.TwoD\Luxel.Graphics.TwoD.csproj" />
    <ProjectReference Include="..\..\src\Luxel.Graphics\Luxel.Graphics.csproj" />
    <ProjectReference Include="..\..\src\Luxel.Graphics.WebGPU.Browser\Luxel.Graphics.WebGPU.Browser.csproj" />
    <ProjectReference Include="..\..\src\Luxel.Typography\Luxel.Typography.csproj"
                      AdditionalProperties="LuxelBrowserWasm=true" />
    <ProjectReference Include="..\..\src\Luxel.UI\Luxel.UI.csproj" />
    <ProjectReference Include="..\..\src\Luxel.Platform\Luxel.Platform.csproj" />
    <ProjectReference Include="..\..\src\Luxel.Platform.Web\Luxel.Platform.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Luxel.Typography carries desktop Linux assets for native consumers. The browser root
         explicitly suppresses those transitive assets so the WebAssembly module owns libHarfBuzzSharp. -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.0" ExcludeAssets="all" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Shaders\compute.wgsl" />
    <EmbeddedResource Include="..\..\shaders\compiled\raster2d_bounds.wgsl" Link="Shaders\raster2d_bounds.wgsl" />
    <EmbeddedResource Include="..\..\shaders\compiled\raster2d_bin.wgsl" Link="Shaders\raster2d_bin.wgsl" />
    <EmbeddedResource Include="..\..\shaders\compiled\raster2d_fine.wgsl" Link="Shaders\raster2d_fine.wgsl" />
    <EmbeddedResource Include="..\..\assets\fonts\BIZUDGothic-Regular.ttf" Link="Fonts\BIZUDGothic-Regular.ttf" />
    <EmbeddedResource Include="..\..\shaders\compiled\tutorial_triangle.wgsl" Link="Shaders\tutorial_triangle.wgsl" />
    <Content Include="..\..\src\Luxel.Graphics.WebGPU.Browser\wwwroot\luxel-webgpu-browser.js"
             Link="wwwroot\luxel-webgpu-browser.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\src\Luxel.Platform.Web\wwwroot\luxel-platform-web.js"
             Link="wwwroot\luxel-platform-web.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GenerateBrowserRuntimeManifest" BeforeTargets="PrepareForPublish">
    <!-- This is a host-side build tool, not part of the browser dependency closure. `dotnet run`
         gives standalone `dotnet publish <this project>` the restore/build step that a solution restore
         would otherwise provide, then refreshes the checked-in/published descriptor manifest. -->
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../../src/Luxel.Gallery.RuntimeManifest/Luxel.Gallery.RuntimeManifest.csproj&quot; --configuration $(Configuration) -- &quot;$(MSBuildProjectDirectory)/wwwroot/browser-runtime-manifest.json&quot;" />
  </Target>
</Project>
