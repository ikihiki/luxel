@using System.Runtime.InteropServices.JavaScript
@using Luxel.Editor.Browser
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject IBrowserDemoProjectProvider Demo

<header class="demo-toolbar" data-testid="demo-toolbar">
  <button data-testid="open-demo" @onclick='() => Invoke("open-demo")'>Open Demo</button>
  <button data-testid="reset-demo" @onclick='() => Invoke("reset-demo")'>Reset Demo</button>
  <a data-testid="open-gallery" href="@Demo.GalleryUrl">Open Gallery</a>
  <span data-testid="storage-mode">@Demo.StorageDescription</span>
  <span data-testid="storage-permission">Checking browser storage…</span>
</header>
<main class="editor-host">
  <canvas id="luxel-canvas" tabindex="0" aria-label="Luxel Editor demo" data-testid="editor-canvas"></canvas>
  <div id="status" role="status" data-status="loading" data-testid="editor-status">Loading Luxel Editor demo…</div>
  <div id="error" role="alert" hidden></div>
</main>

@code {
  private bool _started;
  private JSObject? _host;
  private JSObject? _storage;
  private JSObject? _webGpu;

  private ValueTask Invoke(string action) => JS.InvokeVoidAsync("luxelEditorAutomation.invoke", action, "");

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender || _started) return;
    _started = true;
    try
    {
      _ = await JS.InvokeAsync<IJSObjectReference>("import", "./main.js");
      _host = await JSHost.ImportAsync("luxel-editor-host", "../main.js");
      _storage = await JSHost.ImportAsync("luxel-editor-storage", "../editor-storage.js");
      _webGpu = await JSHost.ImportAsync("./luxel-webgpu-browser.js", "../luxel-webgpu-browser.js");
      _ = EditorBrowserApplication.RunAsync(Services);
    }
    catch (Exception error)
    {
      await JS.InvokeVoidAsync("luxelEditorStartupFailure", error.ToString());
    }
  }
}
