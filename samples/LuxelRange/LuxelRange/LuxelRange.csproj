<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LuxelRange — スタンドアロン実行ファイル (capstone ②)。実窓・スワップチェーン提示・入力の結線だけを持つ
    薄い層で、ゲームロジックは LuxelRange.Core にある。3D (glTF/scene_pbr/billboard) の publish 検証の本丸。
    RID は publish 時に -r win-x64 で指定する (csproj には固定しない)。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Shared\Luxel.Mathematics\Luxel.Mathematics.csproj" />
    <Using Include="Luxel.Mathematics" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <AssemblyName>LuxelRange</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Platform\Luxel.Platform.Windows\Luxel.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Graphics\Luxel.Graphics.csproj" />
    <ProjectReference Include="..\LuxelRange.Core\LuxelRange.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Platform\Luxel.Platform\Luxel.Platform.csproj" />
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Graphics.Vulkan\Luxel.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\..\..\src\Graphics\Luxel.Graphics.DirectX12\Luxel.Graphics.DirectX12.csproj" />
    <!-- 実時間ゲームループ (GameScene/LuxelHostBuilder) + 入力 -->
    <ProjectReference Include="..\..\..\src\Framework\Luxel.Framework.Game.Native\Luxel.Framework.Game.Native.csproj" />
    <ProjectReference Include="..\..\..\src\Framework\Luxel.Framework.Game\Luxel.Framework.Game.csproj" />
    <ProjectReference Include="..\..\..\src\Input\Luxel.Input\Luxel.Input.csproj" />
    <!-- 3D 描画 (ECS→Render3DExtract→cube_forward、地形メッシュ→scene_pbr_lite、Fox skin→scene_pbr_skinned) -->
    <ProjectReference Include="..\..\..\src\Resources\Luxel.AssetRuntime\Luxel.AssetRuntime.csproj" />
    <!-- glTF ロード (動く的 = Fox.glb のスケルタルスキン) -->
    <ProjectReference Include="..\..\..\src\Resources\Luxel.Assets.Gltf\Luxel.Assets.Gltf.csproj" />
    <!-- 命中パーティクル (.ThreeD ビルボードバースト) -->
    <ProjectReference Include="..\..\..\src\Particles\Luxel.Particles\Luxel.Particles.csproj" />
    <ProjectReference Include="..\..\..\src\Particles\Luxel.Particles.ThreeD\Luxel.Particles.ThreeD.csproj" />
    <!-- セーブの実 IO (PhysicalFileStore を %APPDATA% に向ける) -->
    <ProjectReference Include="..\..\..\src\Framework\Luxel.Settings\Luxel.Settings.csproj" />
  </ItemGroup>

  <!--
    Khronos 公式 glTF-Sample-Assets の Fox.glb を固定コミットから tools/ へ取得する。
    通常はローカルキャッシュを再利用し、毎ビルド SHA-256 を検証してから出力/publish に含める。
  -->
  <PropertyGroup>
    <KhronosFoxCommit>5bad5aaa0bbb5d0f9cdc934e626f27d0df1e79b8</KhronosFoxCommit>
    <KhronosFoxSha256>D97044E701822BAC5A62696459B27D7B375AADA5DE8574ED4362EDBBA94771F7</KhronosFoxSha256>
    <KhronosFoxLicenseSha256>1EA9BA5E4A5F22552E2FEB44719AF14D4139580BEF0CE5DBBA3709AF98CEA445</KhronosFoxLicenseSha256>
    <KhronosSampleCacheDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\tools\khronos-samples'))</KhronosSampleCacheDir>
    <KhronosFoxPath>$([System.IO.Path]::Combine('$(KhronosSampleCacheDir)', 'Fox.glb'))</KhronosFoxPath>
    <KhronosFoxLicensePath>$([System.IO.Path]::Combine('$(KhronosSampleCacheDir)', 'Fox-LICENSE.md'))</KhronosFoxLicensePath>
    <KhronosFoxDownloadedLicensePath>$([System.IO.Path]::Combine('$(KhronosSampleCacheDir)', 'LICENSE.md'))</KhronosFoxDownloadedLicensePath>
    <KhronosFoxUrl>https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/$(KhronosFoxCommit)/Models/Fox/glTF-Binary/Fox.glb</KhronosFoxUrl>
    <KhronosFoxLicenseUrl>https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/$(KhronosFoxCommit)/Models/Fox/LICENSE.md</KhronosFoxLicenseUrl>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(KhronosFoxPath)">
      <Link>assets/Fox.glb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(KhronosFoxLicensePath)">
      <Link>licenses/Fox-LICENSE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="AcquireKhronosFoxAsset" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(KhronosSampleCacheDir)" />
    <DownloadFile Condition="!Exists('$(KhronosFoxPath)')"
                  SourceUrl="$(KhronosFoxUrl)"
                  DestinationFolder="$(KhronosSampleCacheDir)"
                  Retries="3"
                  RetryDelayMilliseconds="1000" />
    <DownloadFile Condition="!Exists('$(KhronosFoxLicensePath)')"
                  SourceUrl="$(KhronosFoxLicenseUrl)"
                  DestinationFolder="$(KhronosSampleCacheDir)"
                  Retries="3"
                  RetryDelayMilliseconds="1000" />
    <Copy Condition="!Exists('$(KhronosFoxLicensePath)') and Exists('$(KhronosFoxDownloadedLicensePath)')"
          SourceFiles="$(KhronosFoxDownloadedLicensePath)"
          DestinationFiles="$(KhronosFoxLicensePath)" />
    <Error Condition="!Exists('$(KhronosFoxPath)')"
           Text="Khronos Fox.glb を取得できませんでした: $(KhronosFoxUrl)" />
    <Error Condition="!Exists('$(KhronosFoxLicensePath)')"
           Text="Khronos Fox のライセンスを取得できませんでした: $(KhronosFoxLicenseUrl)" />
    <GetFileHash Files="$(KhronosFoxPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_KhronosFoxHash" />
    </GetFileHash>
    <GetFileHash Files="$(KhronosFoxLicensePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_KhronosFoxLicenseHash" />
    </GetFileHash>
    <Error Condition="'@(_KhronosFoxHash->'%(FileHash)')' != '$(KhronosFoxSha256)'"
           Text="Fox.glb の SHA-256 が一致しません。$(KhronosFoxPath) を削除して再ビルドしてください。" />
    <Error Condition="'@(_KhronosFoxLicenseHash->'%(FileHash)')' != '$(KhronosFoxLicenseSha256)'"
           Text="Fox-LICENSE.md の SHA-256 が一致しません。$(KhronosFoxLicensePath) を削除して再ビルドしてください。" />
  </Target>

  <!-- Slang シェーダを出力/publish の shaders/ へ。targets 側が publish コピーも面倒を見る。 -->
  <Import Project="..\..\..\shaders\Luxel.Shaders.targets" />

  <ItemGroup>
    <Using Include="Luxel.Graphics" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Luxel.Platform" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Luxel.Platform.Windows" />
  </ItemGroup>
</Project>
