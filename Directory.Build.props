<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 型 API リファレンス (AssemblyApiGenerator) と ApiTable が /// を読むため全プロジェクトで XML doc を出力 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Architecture metadata defaults. Gallery projects override every value explicitly. -->
  <PropertyGroup>
    <LuxelProjectRole Condition="'$(LuxelProjectRole)' == ''">Production</LuxelProjectRole>
    <LuxelGalleryCategory Condition="'$(LuxelGalleryCategory)' == ''">External</LuxelGalleryCategory>
    <LuxelSubsystem Condition="'$(LuxelSubsystem)' == ''">$(MSBuildProjectName)</LuxelSubsystem>
    <LuxelPlatform Condition="'$(LuxelPlatform)' == ''">Portable</LuxelPlatform>
    <LuxelArchitectureTier Condition="'$(LuxelArchitectureTier)' == ''">Product</LuxelArchitectureTier>
  </PropertyGroup>

  <!-- コマンドライン csc は参照アセンブリに DocumentationProvider を付けないため、ソースジェネレーターから
       GetDocumentationCommentXml で参照先の /// は読めない。代わりに ProjectReference の XML doc ファイルを
       AdditionalFiles として渡し、AssemblyApiGenerator が doc-comment ID で直接引く。 -->
  <Target Name="AddReferencedProjectDocsAsAdditionalFiles"
          AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_RefDocCandidate Include="@(_ResolvedProjectReferencePaths->'%(RootDir)%(Directory)%(Filename).xml')" />
      <AdditionalFiles Include="@(_RefDocCandidate)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
  </Target>
</Project>
