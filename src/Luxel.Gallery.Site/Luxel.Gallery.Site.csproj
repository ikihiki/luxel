<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>

  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Luxel.Graphics\Luxel.Graphics.csproj" />
    <ProjectReference Include="..\Luxel.Gallery\Luxel.Gallery.csproj" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Luxel.Gallery.Site.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\highlightjs\highlight.min.js" />
    <EmbeddedResource Include="Assets\highlightjs\github-dark.min.css" />
    <EmbeddedResource Include="Assets\highlightjs\LICENSE" />
  </ItemGroup>

  <!-- Luxel.Gallery owns the shared Khronos Box acquisition target. Importing it here as well lets
       parallel solution builds race while downloading the same cache files. -->
  <Import Project="..\..\assets\Luxel.FontAssets.targets" />
  <Import Project="..\..\shaders\Luxel.Shaders.targets" />
  <ItemGroup>
    <Using Include="Luxel.Graphics" />
  </ItemGroup>
</Project>
