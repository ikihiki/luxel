<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Luxel.UI\Luxel.UI.csproj" />
    <ProjectReference Include="..\Luxel.Animation\Luxel.Animation.csproj" />
    <ProjectReference Include="..\Luxel.TwoD\Luxel.TwoD.csproj" />
    <ProjectReference Include="..\Luxel.Editor\Luxel.Editor.csproj" />
    <!-- 汎用ノードエディタのコア (ADR-0009)。NodeGraphView が投影して描く (canvas 非依存の純データ/幾何) -->
    <ProjectReference Include="..\Luxel.NodeGraph\Luxel.NodeGraph.csproj" />
    <!-- 画像 embed (ImageBlock) が ResourceHandle<CpuImage> を扱う。GPU API は含まれない (Diagnostics のみ依存) -->
    <ProjectReference Include="..\Luxel.Resources\Luxel.Resources.csproj" />
    <ProjectReference Include="..\Luxel\Luxel.csproj" />
    <!-- Widget の DebugProps を reflection なしで焼き込むソースジェネレーター -->
    <ProjectReference Include="..\Luxel.UI.Generators\Luxel.UI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU" />
    <InternalsVisibleTo Include="Luxel.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>   <!-- C# 14 拡張メンバー (テーマ/添付の P 拡張用) -->
    <!-- /// コメントを CLI ビルドでもジェネレーターへ届かせる (ControlApi の説明列)。
         DocumentationMode.None だと GetDocumentationCommentXml が空になる -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
