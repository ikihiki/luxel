<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LuxelProjectRole>GalleryInfrastructure</LuxelProjectRole>
    <LuxelGalleryCategory>Shared</LuxelGalleryCategory>
    <LuxelSubsystem>Gallery</LuxelSubsystem>
    <LuxelPlatform>Portable</LuxelPlatform>
    <LuxelArchitectureTier>Foundation</LuxelArchitectureTier>
    <IsPackable>false</IsPackable>
    <LuxelGalleryRegistrationIdentity>Gallery.UI</LuxelGalleryRegistrationIdentity>
  </PropertyGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Luxel.Gallery\Luxel.Gallery.csproj" />
    <ProjectReference Include="..\..\UI\Luxel.Controls\Luxel.Controls.csproj" />
    <ProjectReference Include="..\..\UI\Luxel.UI\Luxel.UI.csproj" />
    <ProjectReference Include="..\..\Graphics\Luxel.Typography\Luxel.Typography.csproj" />
    <ProjectReference Include="..\..\Shared\Luxel.UI.Generators\Luxel.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;RuntimeIdentifier;SelfContained;PublishSelfContained;IsAotCompatible;EnableAotAnalyzer;EnableTrimAnalyzer;EnableSingleFileAnalyzer" />
    <ProjectReference Include="..\Luxel.Gallery.Generators\Luxel.Gallery.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;RuntimeIdentifier;SelfContained;PublishSelfContained;IsAotCompatible;EnableAotAnalyzer;EnableTrimAnalyzer;EnableSingleFileAnalyzer" />
  </ItemGroup>
</Project>
