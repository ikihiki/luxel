<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LuxelProjectRole>GalleryInfrastructure</LuxelProjectRole>
    <LuxelGalleryCategory>Shared</LuxelGalleryCategory>
    <LuxelSubsystem>Playground</LuxelSubsystem>
    <LuxelPlatform>Portable</LuxelPlatform>
    <LuxelArchitectureTier>Foundation</LuxelArchitectureTier>
    <IsPackable>false</IsPackable>
    <LuxelGalleryRegistrationIdentity>Gallery.Playground</LuxelGalleryRegistrationIdentity>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Resources\Luxel.AssetsGpu\Luxel.AssetsGpu.csproj" />
    <ProjectReference Include="..\..\UI\Luxel.Controls\Luxel.Controls.csproj" />
    <ProjectReference Include="..\..\Resources\Luxel.Imaging\Luxel.Imaging.csproj" />
    <ProjectReference Include="..\..\Resources\Luxel.Resources\Luxel.Resources.csproj" />
    <ProjectReference Include="..\..\Graphics\Luxel.Shaders\Luxel.Shaders.csproj" />
    <ProjectReference Include="..\..\Graphics\Luxel.Shaders.Slang.Native\Luxel.Shaders.Slang.Native.csproj" />
    <ProjectReference Include="..\..\Scripting\Luxel.Scripting.Roslyn.Web\Luxel.Scripting.Roslyn.Web.csproj" />
    <ProjectReference Include="..\..\Scripting\Luxel.Scripting\Luxel.Scripting.csproj" />
    <ProjectReference Include="..\..\Framework\Luxel.Settings\Luxel.Settings.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\luxel-playground.css" />
    <EmbeddedResource Include="wwwroot\luxel-playground.js" />
    <None Update="wwwroot\luxel-playground.css" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="wwwroot\luxel-playground.css" />
    <None Update="wwwroot\luxel-playground.js" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="wwwroot\luxel-playground.js" />
  </ItemGroup>
</Project>
