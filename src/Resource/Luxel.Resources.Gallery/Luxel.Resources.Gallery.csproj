<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Static glTF story fixtures are pinned and acquired by this shared target. -->
  <Import Project="..\..\..\assets\Luxel.KhronosBox.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\Gallery\Luxel.Gallery\Luxel.Gallery.csproj" />
    <ProjectReference Include="..\..\Gallery\Luxel.Gallery.DocKit\Luxel.Gallery.DocKit.csproj" />
    <ProjectReference Include="..\Luxel.Assets.Gltf\Luxel.Assets.Gltf.csproj" />
    <ProjectReference Include="..\..\Luxel.Ecs\Luxel.Ecs.csproj" />
    <ProjectReference Include="..\..\Luxel.Graphics\Luxel.Graphics.csproj" />
    <ProjectReference Include="..\..\Luxel.Graphics.RenderGraph\Luxel.Graphics.RenderGraph.csproj" />
    <ProjectReference Include="..\Luxel.Assets\Luxel.Assets.csproj" />
    <ProjectReference Include="..\Luxel.AssetsGpu\Luxel.AssetsGpu.csproj" />
    <ProjectReference Include="..\Luxel.AssetRuntime\Luxel.AssetRuntime.csproj" />
    <ProjectReference Include="..\..\Gallery\Luxel.Gallery.Generators\Luxel.Gallery.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;RuntimeIdentifier;SelfContained;PublishSelfContained;IsAotCompatible;EnableAotAnalyzer;EnableTrimAnalyzer;EnableSingleFileAnalyzer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Luxel.Gallery.Site.Tests" />
    <EmbeddedResource Include="..\..\..\samples\LuxelResources\LuxelResources.csproj" LogicalName="Luxel.Sample.samples.LuxelResources.LuxelResources.csproj" />
    <EmbeddedResource Include="..\..\..\samples\LuxelResources\Program.cs" LogicalName="Luxel.Sample.samples.LuxelResources.Program.cs" />
    <EmbeddedResource Include="$(KhronosBoxGltfPath)" LogicalName="Luxel.Gallery.Resources.Fixtures.Box.gltf" />
    <EmbeddedResource Include="$(KhronosBoxBinPath)" LogicalName="Luxel.Gallery.Resources.Fixtures.Box0.bin" />
    <EmbeddedResource Include="$(KhronosBoxAnimatedPath)" LogicalName="Luxel.Gallery.Resources.Fixtures.BoxAnimated.glb" />
    <EmbeddedResource Include="$(KhronosRiggedSimplePath)" LogicalName="Luxel.Gallery.Resources.Fixtures.RiggedSimple.glb" />
    <EmbeddedResource Include="..\..\..\shaders\compiled\scene_pbr_lite.*" LogicalName="Luxel.Gallery.Resources.Shaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\shaders\compiled\scene_pbr_skinned.*" LogicalName="Luxel.Gallery.Resources.Shaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\shaders\compiled\scene_pbr_morph.*" LogicalName="Luxel.Gallery.Resources.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Luxel.Gallery" />
    <Using Include="Luxel.Graphics" />
  </ItemGroup>

</Project>
