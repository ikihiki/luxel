    <EmbeddedResource Include="..\..\shaders\compiled\triangle.wgsl" LogicalName="Luxel.Graphics.Gallery.Shaders.triangle.wgsl" WithCulture="false" />
    <EmbeddedResource Include="..\..\shaders\compiled\cube_forward.*" Link="Shaders\%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="..\..\shaders\compiled\raster2d_bounds.*" Link="Shaders\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\shaders\compiled\raster2d_bin.*" Link="Shaders\%(Filename)%(Extension)" />
