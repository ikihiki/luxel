    <ProjectReference Include="..\Gallery\Luxel.Gallery\Luxel.Gallery.csproj" />
    <ProjectReference Include="..\Gallery\Luxel.Gallery.DocKit\Luxel.Gallery.DocKit.csproj" />
    <ProjectReference Include="..\Gallery\Luxel.Gallery.UI\Luxel.Gallery.UI.csproj" />
    <ProjectReference Include="..\Luxel.Controls\Luxel.Controls.csproj" />
    <ProjectReference Include="..\Luxel.Graphics\Luxel.Graphics.csproj" />
    <ProjectReference Include="..\Luxel.Graphics.RenderGraph\Luxel.Graphics.RenderGraph.csproj" />
    <ProjectReference Include="..\Luxel.Graphics.TwoD\Luxel.Graphics.TwoD.csproj" />
    <ProjectReference Include="..\Luxel.Mathematics\Luxel.Mathematics.csproj" />
    <ProjectReference Include="..\Luxel.Particles\Luxel.Particles.csproj" />
    <ProjectReference Include="..\Luxel.Particles.TwoD\Luxel.Particles.TwoD.csproj" />
    <ProjectReference Include="..\Luxel.Shaders\Luxel.Shaders.csproj" />
