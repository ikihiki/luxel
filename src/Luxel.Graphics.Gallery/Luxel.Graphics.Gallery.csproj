    <ProjectReference Include="..\Resource\Luxel.AssetsGpu\Luxel.AssetsGpu.csproj" />
    <ProjectReference Include="..\Resource\Luxel.Resources\Luxel.Resources.csproj" />
    <ProjectReference Include="..\Gallery\Luxel.Gallery.Generators\Luxel.Gallery.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;RuntimeIdentifier;SelfContained;PublishSelfContained;IsAotCompatible;EnableAotAnalyzer;EnableTrimAnalyzer;EnableSingleFileAnalyzer" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Luxel.Gallery" />
    <Using Include="Luxel.Graphics" />
    <Using Include="Luxel.Mathematics" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\shaders\compiled\triangle.spv" LogicalName="Luxel.Graphics.Gallery.Shaders.triangle.spv" WithCulture="false" />
    <EmbeddedResource Include="..\..\shaders\compiled\triangle.vs.dxil" LogicalName="Luxel.Graphics.Gallery.Shaders.triangle.vs.dxil" WithCulture="false" />
