<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LuxelProjectRole>Production</LuxelProjectRole>
    <LuxelSubsystem>Editor.UI</LuxelSubsystem>
    <LuxelPlatform>Portable</LuxelPlatform>
    <LuxelArchitectureTier>Extension</LuxelArchitectureTier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Luxel.Mathematics\Luxel.Mathematics.csproj" />
    <ProjectReference Include="..\..\UI\Luxel.Controls\Luxel.Controls.csproj" />
    <ProjectReference Include="..\Luxel.SceneEdit\Luxel.SceneEdit.csproj" />
    <ProjectReference Include="..\Luxel.Workbench\Luxel.Workbench.csproj" />
    <ProjectReference Include="..\..\Shared\Luxel.UI.Generators\Luxel.UI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;RuntimeIdentifier;SelfContained;PublishSelfContained;IsAotCompatible;EnableAotAnalyzer;EnableTrimAnalyzer;EnableSingleFileAnalyzer" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Luxel.Mathematics" />
    <Using Include="Luxel.Graphics" />
    <Using Include="Luxel.Platform" />
  </ItemGroup>
</Project>
