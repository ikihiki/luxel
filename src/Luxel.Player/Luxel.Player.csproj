<Project Sdk="Microsoft.NET.Sdk">

  <!-- データ駆動ゲームランタイム (ADR-0015/0018 / ToDo 27 GE-3)。Luxel Studio の
       プロジェクトフォルダ (project.luxel + scenes + assets) を IVirtualFileSystem から
       読み、SceneCompiler がランタイム world へ一方向に構築して駆動する。
       コンパイラはコア + space 別バックエンド (M11 = 2D のみ、3D は M12/GE-9)。
       csx ビヘイビア (ScriptHost) は GE-3 S2、exe (Luxel.Player.App) は S3 で足す。 -->
  <ItemGroup>
    <ProjectReference Include="..\Luxel.SceneEdit\Luxel.SceneEdit.csproj" />
    <ProjectReference Include="..\Luxel.Resources\Luxel.Resources.csproj" />
    <ProjectReference Include="..\Luxel.Graphics.TwoD\Luxel.Graphics.TwoD.csproj" />
    <ProjectReference Include="..\Luxel.Typography.TwoD\Luxel.Typography.TwoD.csproj" />
    <ProjectReference Include="..\Luxel.Typography\Luxel.Typography.csproj" />
    <!-- csx ビヘイビア (ADR-0018): ScriptHost (Roslyn) でコンパイル・毎ステップ実行 -->
    <ProjectReference Include="..\Luxel.Scripting\Luxel.Scripting.csproj" />
    <InternalsVisibleTo Include="Luxel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luxel.Mathematics\Luxel.Mathematics.csproj" />
    <Using Include="Luxel.Mathematics" />
  </ItemGroup>

  <PropertyGroup>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
