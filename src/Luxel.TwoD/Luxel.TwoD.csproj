<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Luxel.Tests" />
    <InternalsVisibleTo Include="Luxel.TwoD.Skia" />
    <ProjectReference Include="..\Luxel\Luxel.csproj" />
    <!-- スプライトアトラス JSON のロード (SpriteAtlasStep)。Resources は CPU のみ (GPU 非依存)。 -->
    <ProjectReference Include="..\Luxel.Resources\Luxel.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
