<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Luxel.Player.App — Studio プロジェクトフォルダを実行する汎用プレイヤー exe (ToDo 27 GE-3 S3)。
      Luxel.Player.App[.exe] <プロジェクトフォルダ> [vk|dx] [-frames N]
    実窓・提示・入力の結線だけの薄い層 (LuxelCavern exe と同型)。ランタイムは Luxel.Player。
    出荷 (publish + コンテンツコピー) は GE-6。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Luxel.Player.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luxel.Player\Luxel.Player.csproj" />
    <ProjectReference Include="..\Luxel.Platform\Luxel.Platform.csproj" />
    <ProjectReference Include="..\Luxel.Vulkan\Luxel.Vulkan.csproj" />
    <ProjectReference Include="..\Luxel.D3D12\Luxel.D3D12.csproj" />
    <ProjectReference Include="..\Luxel.Framework\Luxel.Framework.csproj" />
  </ItemGroup>

  <!-- Slang シェーダ (Rasterizer2D 用) を出力/publish の shaders/ へ -->
  <Import Project="..\..\shaders\Luxel.Shaders.targets" />

</Project>
