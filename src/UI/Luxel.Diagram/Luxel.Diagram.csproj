<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <!-- /// を ControlApi (ApiTable) へ届かせる -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luxel.UI\Luxel.UI.csproj" />
    <ProjectReference Include="..\..\Graphics\Luxel.Graphics.TwoD\Luxel.Graphics.TwoD.csproj" />
    <ProjectReference Include="..\..\Graphics\Luxel.Typography\Luxel.Typography.csproj" />
    <ProjectReference Include="..\..\Graphics\Luxel.Typography.TwoD\Luxel.Typography.TwoD.csproj" />
    <!-- [UiComponent] のファクトリ/デバッグ焼き込み (別アセンブリでも生成される) -->
    <ProjectReference Include="..\..\Shared\Luxel.UI.Generators\Luxel.UI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;RuntimeIdentifier;SelfContained;PublishSelfContained;IsAotCompatible;EnableAotAnalyzer;EnableTrimAnalyzer;EnableSingleFileAnalyzer" />
    <InternalsVisibleTo Include="Luxel.Animation.Tests" />
    <InternalsVisibleTo Include="Luxel.Audio.Tests" />
    <InternalsVisibleTo Include="Luxel.DevTools.Tests" />
    <InternalsVisibleTo Include="Luxel.Editor.Tests" />
    <InternalsVisibleTo Include="Luxel.Framework.Tests" />
    <InternalsVisibleTo Include="Luxel.Gallery.Tests" />
    <InternalsVisibleTo Include="Luxel.GamesSamples.Tests" />
    <InternalsVisibleTo Include="Luxel.Graphics.Tests" />
    <InternalsVisibleTo Include="Luxel.Input.Tests" />
    <InternalsVisibleTo Include="Luxel.Particles.Tests" />
    <InternalsVisibleTo Include="Luxel.Platform.Tests" />
    <InternalsVisibleTo Include="Luxel.Resources.Tests" />
    <InternalsVisibleTo Include="Luxel.Scripting.Tests" />
    <InternalsVisibleTo Include="Luxel.Shared.Tests" />
    <InternalsVisibleTo Include="Luxel.UI.Tests" />
  </ItemGroup>

</Project>
