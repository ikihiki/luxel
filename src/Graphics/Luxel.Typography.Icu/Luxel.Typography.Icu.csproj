<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Luxel.Typography\Luxel.Typography.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="icu.net" Version="3.0.2" />
    <!-- icu.net transitively pins Newtonsoft.Json 9.0.1 through DependencyModel 2.x. Override the
         vulnerable compile-time dependency while retaining the only available icu.net adapter. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

  <PropertyGroup>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
