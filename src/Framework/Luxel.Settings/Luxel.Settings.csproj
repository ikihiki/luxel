<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Signal<T> (双方向バインドの肝) を返すため UI 参照。file IO は BCL のみ。 -->
    <ProjectReference Include="..\..\UI\Luxel.UI\Luxel.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 設定値を DI で取れるよう Microsoft.Extensions.Options / DI に対応 (Hosting と同じ 9.0.0) -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <!-- 読み込みは .NET 標準の Configuration (JSON + 環境変数 + コマンドライン のレイヤ) を採用 -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Luxel.Animation.Tests" />
    <InternalsVisibleTo Include="Luxel.Audio.Tests" />
    <InternalsVisibleTo Include="Luxel.DevTools.Tests" />
    <InternalsVisibleTo Include="Luxel.Editor.Tests" />
    <InternalsVisibleTo Include="Luxel.Framework.Tests" />
    <InternalsVisibleTo Include="Luxel.Gallery.Tests" />
    <InternalsVisibleTo Include="Luxel.GamesSamples.Tests" />
    <InternalsVisibleTo Include="Luxel.Graphics.Tests" />
    <InternalsVisibleTo Include="Luxel.Input.Tests" />
    <InternalsVisibleTo Include="Luxel.Particles.Tests" />
    <InternalsVisibleTo Include="Luxel.Platform.Tests" />
    <InternalsVisibleTo Include="Luxel.Resources.Tests" />
    <InternalsVisibleTo Include="Luxel.Scripting.Tests" />
    <InternalsVisibleTo Include="Luxel.Shared.Tests" />
    <InternalsVisibleTo Include="Luxel.UI.Tests" />
  </ItemGroup>

</Project>
