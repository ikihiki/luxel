  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Luxel.Diagnostics\Luxel.Diagnostics.csproj" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\Luxel.Graphics\Luxel.Graphics.csproj" />
    <ProjectReference Include="..\Luxel.Framework.Game\Luxel.Framework.Game.csproj" />
    <ProjectReference Include="..\..\Luxel.DevTools\Luxel.DevTools.csproj" />
    <ProjectReference Include="..\..\Luxel.DevTools.App\Luxel.DevTools.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Luxel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Luxel.Graphics" />
  </ItemGroup>
</Project>
