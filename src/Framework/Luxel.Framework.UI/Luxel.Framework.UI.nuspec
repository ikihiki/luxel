<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Luxel.Framework.UI</id>
    <version>$Version$</version>
    <authors>Luxel contributors</authors>
    <description>Cross-platform Luxel UI application facade for .NET 10.</description>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <repository type="git" url="https://github.com/ikihiki/luxel" />
    <contentFiles>
      <files include="any/any/**" buildAction="None" copyToOutput="true" flatten="false" />
    </contentFiles>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Silk.NET.Windowing" version="[2.23.0]" />
        <dependency id="Silk.NET.WebGPU" version="[2.23.0]" />
        <dependency id="Silk.NET.WebGPU.Extensions.WGPU" version="[2.23.0]" />
        <dependency id="Silk.NET.WebGPU.Native.WGPU" version="[2.23.0]" />
        <dependency id="Silk.NET.Vulkan" version="[2.23.0]" />
        <dependency id="Silk.NET.Vulkan.Extensions.EXT" version="[2.23.0]" />
        <dependency id="Silk.NET.Vulkan.Extensions.KHR" version="[2.23.0]" />
        <dependency id="HarfBuzzSharp" version="[14.2.0]" />
        <dependency id="HarfBuzzSharp.NativeAssets.Linux" version="[14.2.0]" />
        <dependency id="Vortice.Direct3D12" version="[3.8.3]" />
        <dependency id="Vortice.DXGI" version="[3.8.3]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="README.md" target="" />
    <file src="bin\$configuration$\net10.0\Luxel*.dll" target="lib\net10.0" />
    <file src="..\..\Platform\Luxel.Terminal.Linux\bin\$configuration$\net10.0\libluxelpty.so" target="runtimes\linux-x64\native" />
    <file src="..\..\Shared\Luxel.UI.Generators\bin\$configuration$\netstandard2.0\Luxel.UI.Generators.dll" target="analyzers\dotnet\cs" />
    <file src="buildTransitive\Luxel.Framework.UI.targets" target="buildTransitive" />
    <file src="..\..\..\shaders\compiled\*.spv" target="contentFiles\any\any\shaders" />
    <file src="..\..\..\shaders\compiled\*.dxil" target="contentFiles\any\any\shaders" />
    <file src="..\..\..\shaders\compiled\*.wgsl" target="contentFiles\any\any\shaders" />
    <file src="..\..\..\shaders\compiled\webgpu-shaders.json" target="contentFiles\any\any\shaders" />
    <file src="..\..\..\assets\fonts\BIZUDGothic-Regular.ttf" target="contentFiles\any\any\assets\fonts" />
    <file src="..\..\..\assets\fonts\BIZUDGothic-OFL.txt" target="contentFiles\any\any\assets\fonts\OFL.txt" />
  </files>
</package>
