<Project Sdk="Microsoft.NET.Sdk">

  <!-- 複数エディタを束ねる Workbench フレームワークのコア (ADR-0010 / ToDo 26 WS-C)。
       エディタは特定型をハードコードせず IEditorDocument の不透明ハンドルとして載る —
       各スタック (Luxel.Document / Luxel.NodeGraph) の内部モデルは統一しない。
       canvas/GPU 非依存 (契約に Widget/Signal が出るため Luxel.UI のみ参照、実体化はしない)。
       DockTree / IDocumentStore は S(C2) で足す。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Luxel.Tests" />
    <ProjectReference Include="..\Luxel.UI\Luxel.UI.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
