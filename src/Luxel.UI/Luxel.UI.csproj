<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Luxel.Platform\Luxel.Platform.csproj" />
    <ProjectReference Include="..\Luxel.Graphics\Luxel.Graphics.csproj" />
    <InternalsVisibleTo Include="Luxel.Tests" />
    <ProjectReference Include="..\Luxel.Typography\Luxel.Typography.csproj" />
    <ProjectReference Include="..\Luxel.Graphics.TwoD\Luxel.Graphics.TwoD.csproj" />
    <ProjectReference Include="..\Luxel.Typography.TwoD\Luxel.Typography.TwoD.csproj" />
    <ProjectReference Include="..\Luxel.Animation\Luxel.Animation.csproj" />
    <!-- StoryContext.Resources (ホスト所有 ResourceSystem の配布窓口) -->
    <ProjectReference Include="..\Luxel.Resources\Luxel.Resources.csproj" />
    <!-- Widget の DebugProps を reflection なしで焼き込むソースジェネレーター -->
    <ProjectReference Include="..\Luxel.UI.Generators\Luxel.UI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;RuntimeIdentifier;SelfContained;PublishSelfContained;IsAotCompatible;EnableAotAnalyzer;EnableTrimAnalyzer;EnableSingleFileAnalyzer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luxel.Mathematics\Luxel.Mathematics.csproj" />
    <Using Include="Luxel.Mathematics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luxel.Diagnostics\Luxel.Diagnostics.csproj" />
  </ItemGroup>

  <PropertyGroup>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>   <!-- C# 14 拡張メンバー (拡張プロパティ/静的) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Luxel.Graphics" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Luxel.Platform" />
  </ItemGroup>
</Project>
