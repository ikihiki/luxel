<Project>
  <PropertyGroup>
    <_LuxelUiAppContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\contentFiles\any\any'))</_LuxelUiAppContentRoot>
  </PropertyGroup>
  <ItemGroup>
    <_LuxelUiAppAsset Include="$(_LuxelUiAppContentRoot)\shaders\*" TargetSubPath="shaders\%(Filename)%(Extension)" />
    <_LuxelUiAppAsset Include="$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'silk.net.webgpu.native.wgpu', '2.23.0', 'runtimes', 'linux-x64', 'native', 'libwgpu_native.so'))"
                      Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'"
                      TargetSubPath="libwgpu_native.so" />
    <_LuxelUiAppAsset Include="$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'silk.net.webgpu.native.wgpu', '2.23.0', 'runtimes', 'linux-arm64', 'native', 'libwgpu_native.so'))"
                      Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'"
                      TargetSubPath="libwgpu_native.so" />
    <_LuxelUiAppAsset Include="$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'silk.net.webgpu.native.wgpu', '2.23.0', 'runtimes', 'win-x64', 'native', 'wgpu_native.dll'))"
                      Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'"
                      TargetSubPath="wgpu_native.dll" />
    <_LuxelUiAppAsset Include="$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'silk.net.webgpu.native.wgpu', '2.23.0', 'runtimes', 'win-arm64', 'native', 'wgpu_native.dll'))"
                      Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'"
                      TargetSubPath="wgpu_native.dll" />
    <_LuxelUiAppAsset Include="$(_LuxelUiAppContentRoot)\assets\fonts\*" TargetSubPath="assets\fonts\%(Filename)%(Extension)" />
    <Content Include="@(_LuxelUiAppAsset)"
             Link="%(_LuxelUiAppAsset.TargetSubPath)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <_LuxelUiAppRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</_LuxelUiAppRuntimeIdentifier>
    <_LuxelUiAppRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_LuxelUiAppRuntimeIdentifier>
  </PropertyGroup>
  <Target Name="CopyLuxelGlfwCompatibilityAlias" AfterTargets="CopyFilesToOutputDirectory"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(_LuxelUiAppRuntimeIdentifier)' == 'linux-x64'">
    <ItemGroup>
      <_LuxelGlfwOutputSource Include="$(OutDir)libglfw.so.3" Condition="Exists('$(OutDir)libglfw.so.3')" />
      <_LuxelGlfwOutputSource Include="$(OutDir)runtimes/$(_LuxelUiAppRuntimeIdentifier)/native/libglfw.so.3"
                              Condition="'@(_LuxelGlfwOutputSource)' == '' and Exists('$(OutDir)runtimes/$(_LuxelUiAppRuntimeIdentifier)/native/libglfw.so.3')" />
    </ItemGroup>
    <Copy SourceFiles="@(_LuxelGlfwOutputSource)"
          DestinationFiles="@(_LuxelGlfwOutputSource->'$(OutDir)libglfw.so.3.3')"
          SkipUnchangedFiles="true"
          Condition="'@(_LuxelGlfwOutputSource)' != ''" />
  </Target>
  <Target Name="PublishLuxelGlfwCompatibilityAlias" AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(_LuxelUiAppRuntimeIdentifier)' == 'linux-x64'">
    <ItemGroup>
      <_LuxelGlfwPublishSource Include="$(PublishDir)libglfw.so.3" Condition="Exists('$(PublishDir)libglfw.so.3')" />
      <_LuxelGlfwPublishSource Include="$(PublishDir)runtimes/$(_LuxelUiAppRuntimeIdentifier)/native/libglfw.so.3"
                               Condition="'@(_LuxelGlfwPublishSource)' == '' and Exists('$(PublishDir)runtimes/$(_LuxelUiAppRuntimeIdentifier)/native/libglfw.so.3')" />
    </ItemGroup>
    <Copy SourceFiles="@(_LuxelGlfwPublishSource)"
          DestinationFiles="@(_LuxelGlfwPublishSource->'$(PublishDir)libglfw.so.3.3')"
          SkipUnchangedFiles="true"
          Condition="'@(_LuxelGlfwPublishSource)' != ''" />
  </Target>
</Project>
