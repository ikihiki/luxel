<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LuxelProjectRole>GalleryCategory</LuxelProjectRole>
    <LuxelGalleryCategory>DevTools</LuxelGalleryCategory>
    <LuxelSubsystem>DevTools</LuxelSubsystem>
    <LuxelPlatform>Browser</LuxelPlatform>
    <LuxelArchitectureTier>Base</LuxelArchitectureTier>
    <LuxelGalleryCompatibility>Browser;Native</LuxelGalleryCompatibility>
    <IsPackable>false</IsPackable>
    <LuxelGalleryRegistrationIdentity>DevTools.Base</LuxelGalleryRegistrationIdentity>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Gallery/Luxel.Gallery/Luxel.Gallery.csproj" />
    <ProjectReference Include="../Luxel.DevTools/Luxel.DevTools.csproj" />
    <ProjectReference Include="../Gallery/Luxel.Gallery.Generators/Luxel.Gallery.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;RuntimeIdentifier;SelfContained;PublishSelfContained;IsAotCompatible;EnableAotAnalyzer;EnableTrimAnalyzer;EnableSingleFileAnalyzer" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Luxel.Gallery" />
  </ItemGroup>
</Project>
