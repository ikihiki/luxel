{
  "name": "Luxel",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Luxel Desktop",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "LUXEL_DESKTOP_RENDERER": "lavapipe",
    "LUXEL_DESKTOP_AUDIO": "off"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-vscode.cpptools",
        "slevesque.shader"
      ]
    }
  }
}
